{
  "name": "systemdesigner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "node scripts/prepare-next-dev.cjs && next dev",
    "build": "next build && node scripts/validate-content-build-trace.cjs",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty false --incremental false",
    "validate:registry": "node scripts/validate-content-registry.cjs",
    "format:registry": "node scripts/sync-content-registry-data.cjs",
    "audit:content": "node scripts/audit-content-structure.cjs --strict",
    "validate:content": "node scripts/validate-content.cjs && node scripts/generate-content-block-registry.cjs --check",
    "generate:content-blocks": "node scripts/generate-content-block-registry.cjs",
    "qa:content-pages": "node scripts/verify-content-pages.mjs",
    "qa:learning-path": "node scripts/verify-daily-learning.mjs",
    "scan:secrets": "node scripts/scan-secrets.cjs",
    "scan:secrets:history": "node scripts/scan-secrets.cjs --history",
    "create:public-export": "node scripts/create-public-export.cjs",
    "check": "node scripts/scan-secrets.cjs && node scripts/audit-content-structure.cjs --strict && node scripts/validate-content-registry.cjs --strict && node scripts/validate-content.cjs && tsc --noEmit --pretty false --incremental false && vitest run && next lint && next build"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@lexical/clipboard": "0.36.2",
    "@lexical/code": "0.36.2",
    "@lexical/html": "0.36.2",
    "@lexical/link": "0.36.2",
    "@lexical/list": "0.36.2",
    "@lexical/markdown": "0.36.2",
    "@lexical/react": "0.36.2",
    "@lexical/rich-text": "0.36.2",
    "@lexical/selection": "0.36.2",
    "@lexical/table": "0.36.2",
    "@lexical/utils": "0.36.2",
    "@markdoc/markdoc": "^0.5.7",
    "@octokit/auth-app": "^7.2.2",
    "@octokit/rest": "^21.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/extension-list-item": "^3.6.5",
    "@tiptap/extension-task-item": "^3.6.5",
    "@tiptap/extension-task-list": "^3.6.5",
    "@tiptap/react": "^3.6.5",
    "@tiptap/starter-kit": "^3.6.5",
    "@tldraw/tldraw": "^2.4.6",
    "@types/prismjs": "^1.26.5",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.3.0",
    "framer-motion": "^12.23.22",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.0.2",
    "lexical": "0.36.2",
    "lucide-react": "^0.540.0",
    "marked": "^16.3.0",
    "next": "^14.2.35",
    "next-mdx-remote": "6.0.0",
    "next-pwa": "^5.6.0",
    "openai": "^5.23.2",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.6",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-firebase-hooks": "^5.1.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.2.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.19.19",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@types/turndown": "^5.0.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
