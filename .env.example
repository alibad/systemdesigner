# =============================================================================
# SystemDesigner — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in only what you need:
#
#   cp .env.example .env.local
#
# EVERYTHING HERE IS OPTIONAL. Most contributors should not create this file.
# The app runs locally with NO variables set: content, quizzes, calculators,
# tests, lint, and builds all work without secrets.
#
# Set variables only when you are working on a feature that needs them:
# Firebase auth/sync, admin screens on your fork, feedback-to-GitHub, optional
# AI helpers, or production deployment verification. See docs/DEVELOPMENT.md.
#
# NEXT_PUBLIC_* values are embedded in the client bundle (that's expected —
# Firebase web keys are public identifiers, secured by Firestore/Storage rules,
# not by secrecy). NEVER put a real secret behind a NEXT_PUBLIC_ prefix.
# =============================================================================


# --- Firebase (optional) -----------------------------------------------------
# Enables sign-in, cross-device progress sync, and saved diagrams.
# The six core keys are required *together* if you want auth; leave them all
# empty to stay in anonymous mode. Get them from the Firebase Console
# (Project settings → Your apps → Web app config).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=      # Google Analytics id (e.g. G-XXXXXXXXXX), optional
# The feedback widget uploads media (screenshots/video/voice) to Storage via the
# Firebase web SDK. The feedback/ path allows public reads for GitHub issue
# embeds, but writes require Firebase auth; the client signs in anonymously first.
# For public deployments, also enable Firebase App Check on Storage to reduce
# scripted abuse. See storage.rules and SECURITY.md.


# --- Admin allow-list (optional) ---------------------------------------------
# Comma-separated emails that unlock the maintainer/admin UI on your deployment.
# IMPORTANT for forks: if you leave this unset, no account has admin access.
# Example when you need the maintainer UI: NEXT_PUBLIC_ADMIN_EMAILS=you@example.com
NEXT_PUBLIC_ADMIN_EMAILS=
# Where admin activity emails are sent (server-only). Comma-separated.
ADMIN_NOTIFICATION_EMAILS=


# --- In-app "Edit this page" links (optional) --------------------------------
# Repo + branch used by the per-lesson "Edit on GitHub" / "Suggest an
# improvement" links. Point these at your fork. No credentials needed.
NEXT_PUBLIC_GITHUB_REPO=alibad/systemdesigner
NEXT_PUBLIC_GITHUB_BRANCH=main


# --- Public app URL (optional) -----------------------------------------------
# Canonical site URL — used for SEO metadata, canonical links, and emails.
NEXT_PUBLIC_APP_URL=https://systemdesigner.net


# --- Feedback + production content editing (optional, server-only) ------------
# Lets the feedback widget open issues and lets admins save content through a
# GitHub App (more secure than a personal token — scoped to one repo, tokens
# auto-rotate). Grant Issues: Read & Write and Contents: Read & Write, install it
# on your repo, then set the vars below.
# See docs/DEVELOPMENT.md for the step-by-step. Without these the widget still
# works — it just won't auto-create issues.
GITHUB_REPO_OWNER=alibad
GITHUB_REPO_NAME=systemdesigner
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Provide the App private key as a file path (local dev) OR inline as a raw or
# base64-encoded PEM (good for hosting env vars). Set exactly one.
GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_PRIVATE_KEY=

# Content Studio drafts use .content-cms/ locally and a dedicated GitHub branch
# in production. Publish writes the validated lesson to the public content branch.
# Override only when your hosting model needs the other persistence behavior.
# ADMIN_CONTENT_PERSISTENCE=filesystem
# GITHUB_CMS_DRAFT_BRANCH=cms-drafts


# --- OpenAI (optional, server-only) ------------------------------------------
# Powers maintainer-side content-generation scripts AND the optional in-app AI
# features: the "explain this" helper and the design-challenge coaching note.
# Grading is deterministic and works with NO key — the LLM only adds a
# non-scoring narrative. Never required to run or build the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# Model used for the (optional) design-challenge coaching note in /api/grade.
OPENAI_GRADER_MODEL=gpt-4o


# --- SEO (optional, server-only) ---------------------------------------------
# Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=
