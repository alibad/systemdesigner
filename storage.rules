rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(diagramId) {
      return request.auth != null &&
             firestore.exists(/databases/(default)/documents/diagrams/$(diagramId)) &&
             firestore.get(/databases/(default)/documents/diagrams/$(diagramId)).data.createdBy == request.auth.uid;
    }

    function isPublic(diagramId) {
      return firestore.exists(/databases/(default)/documents/diagrams/$(diagramId)) &&
             firestore.get(/databases/(default)/documents/diagrams/$(diagramId)).data.visibility == 'public';
    }

    match /diagrams/{diagramId}/assets/{file} {
      // Allow read if public, owner, or just authenticated (for immediate download after upload)
      allow read: if request.auth != null || isPublic(diagramId);
      
      // Allow write for authenticated users (diagram will be created on first save)
      allow create, update: if request.auth != null;
      
      // Only owner can delete (once diagram exists)
      allow delete: if isOwner(diagramId);
    }

    // Feedback widget uploads (screenshots, screen recordings, voice notes,
    // attachments, diagnostics). Files land flat under feedback/<timestamp>-<name>.
    // They are PRIVATE: this repository and its issues are public, and reads used
    // to be open to anyone (listing included). Issues now link to
    // /admin/feedback/file, which reads the file with the maintainer's sign-in
    // (lib/feedback/private-files.ts). The client signs in anonymously to upload
    // and may only create new files, not overwrite existing ones.
    function isFeedbackReader() {
      return request.auth != null && (
        (request.auth.token.get('email', '') == 'alibadereddin@gmail.com'
         && request.auth.token.get('email_verified', false) == true)
        || (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true));
    }

    match /feedback/{allPaths=**} {
      allow read: if isFeedbackReader();
      allow create: if request.auth != null
        && resource == null
        && request.resource.size < 15 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
