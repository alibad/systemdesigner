            "ai-governance-regulation"
          ]
        },
        {
          "id": "genai-design",
          "title": "Design AI applications",
          "description": "Use a repeatable process to reason about a complete generative AI system.",
          "lessons": [
            "genai-system-design-process",
            "genai-interview-framework",
            "gmail-smart-compose-architecture"
          ]
        }
      ]
    },
    {
      "id": "ml",
