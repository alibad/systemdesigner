            "ai-evaluation-drift"
          ]
        },
        {
          "id": "evaluation-domains",
          "title": "Test reasoning and knowledge",
          "description": "Understand what different benchmarks measure and where they fall short.",
          "lessons": [
            "common-sense-reasoning-benchmarks",
