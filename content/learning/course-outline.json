{
  "version": 1,
  "courses": [
    {
      "id": "design",
      "title": "System design",
      "subtitle": "Build systems that scale",
      "description": "From your first request to distributed storage, resilient services, and complete system designs.",
      "units": [
        {
          "id": "first-system",
          "title": "Your first system",
          "description": "Trace a request, scale a service, and put a cache in the read path.",
          "lessons": [
            "what-is-system-design",
            "scalability-basics",
            "url-shortener-read-path"
          ]
        },
        {
          "id": "performance",
          "title": "Reason about performance",
          "description": "Measure what users experience and find the constraint that actually matters.",
          "lessons": [
            "latency-vs-throughput",
            "performance-metrics",
            "bottleneck-analysis",
            "advanced-scaling",
            "reliability-availability"
          ]
        },
        {
          "id": "storage",
          "title": "Store data correctly",
          "description": "Choose a data model and protect the facts your application cannot lose.",
          "lessons": [
            "database-fundamentals",
            "data-modeling",
            "acid-properties",
            "mysql",
            "postgresql",
            "mongodb"
          ]
        },
        {
          "id": "data-at-scale",
          "title": "Data at scale",
          "description": "Understand partitioning, replication, and the storage structures behind a database.",
          "lessons": [
            "replication-sharding",
            "consistent-hashing",
            "sstable",
            "cassandra",
            "dynamodb"
          ]
        },
        {
          "id": "fast-reads",
          "title": "Make reads fast",
          "description": "Design cache behavior, search indexes, and content delivery around the workload.",
          "lessons": [
            "redis",
            "memcached",
            "elasticsearch",
            "lucene",
            "object-storage",
            "cloudfront"
          ]
        },
        {
          "id": "service-interfaces",
          "title": "Connect services",
          "description": "Design APIs and choose how services exchange requests and streams.",
          "lessons": [
            "api-design",
            "api-paradigms",
            "graphql",
            "grpc",
            "websocket",
            "http2-http3"
          ]
        },
        {
          "id": "async-systems",
          "title": "Asynchronous systems",
          "description": "Decouple work with queues, event streams, and durable workflows.",
          "lessons": [
            "communication-patterns",
            "fundamentals-message-queues",
            "kafka",
            "rabbitmq",
            "sqs",
            "event-driven-architecture",
            "temporal"
          ]
        },
        {
          "id": "resilient-services",
          "title": "Keep services running",
          "description": "Control overload, contain failures, and make recovery a design decision.",
          "lessons": [
            "nginx",
            "proxies-load-balancing",
            "rate-limiting-tech",
            "circuit-breakers",
            "concurrency",
            "chaos-engineering"
          ]
        },
        {
          "id": "production",
          "title": "Ship and operate",
          "description": "Package services, coordinate a cluster, and observe the system in production.",
          "lessons": [
            "monolith-to-microservices",
            "docker",
            "kubernetes",
            "etcd",
            "prometheus",
            "grafana"
          ]
        },
        {
          "id": "secure-systems",
          "title": "Protect the system",
          "description": "Build secure boundaries for identity, credentials, and application traffic.",
          "lessons": [
            "oauth2",
            "jwt",
            "keycloak",
            "vault",
            "advanced-web-security"
          ]
        },
        {
          "id": "design-lab",
          "title": "Design complete services",
          "description": "Apply the building blocks to end-to-end design problems.",
          "lessons": [
            "system-design-framework",
            "practice-url-shortener",
            "practice-chat-system",
            "practice-distributed-cache",
            "practice-payment-system",
            "practice-notification-system"
          ]
        },
        {
          "id": "systems-in-the-wild",
          "title": "Learn from real systems",
          "description": "Compare architectural choices in messaging, streaming, collaboration, and transport.",
          "lessons": [
            "case-study-whatsapp-messaging",
            "case-study-netflix-streaming",
            "case-study-github-collaboration",
            "case-study-uber-ridesharing"
          ]
        }
      ]
    },
    {
      "id": "coding",
      "title": "Coding",
      "subtitle": "Build the components yourself",
      "description": "Write, run, and debug JavaScript building blocks for real services. Every exercise has executable tests.",
      "units": [
        {
          "id": "service-functions",
          "title": "Functions behind a service",
          "description": "Translate capacity, routing, and caching decisions into working JavaScript.",
          "stepIds": [
            "code-capacity",
            "code-routing",
            "code-cache",
            "code-healthy-router"
          ]
        },
        {
          "id": "collections",
          "title": "Collections and batching",
          "description": "Deduplicate, count, group, and batch data safely.",
          "stepIds": [
            "code-unique-ids",
            "code-count-events",
            "code-group-jobs",
            "code-batch-dedup",
            "code-link-service"
          ]
        },
        {
          "id": "api-boundaries",
          "title": "Reliable API boundaries",
          "description": "Validate and normalize input, paginate results, and honor cache expiry.",
          "stepIds": [
            "code-validate-limit",
            "code-normalize-event",
            "code-page-results",
            "code-cache-ttl"
          ]
        },
        {
          "id": "traffic-control",
          "title": "Control traffic",
          "description": "Implement rate-limit models and combine them into a per-tenant admission policy.",
          "stepIds": [
            "code-fixed-window",
            "code-token-bucket",
            "code-sliding-window",
            "code-admit-batch"
          ]
        },
        {
          "id": "safe-state",
          "title": "Make state changes safe",
          "description": "Handle retries, stale writes, conflicting copies, and repeated events.",
          "stepIds": [
            "code-idempotency",
            "code-version-write",
            "code-reconcile-records",
            "code-apply-events"
          ]
        },
        {
          "id": "job-processing",
          "title": "Build a resilient job worker",
          "description": "Schedule work within retry budgets and capacity limits.",
          "stepIds": [
            "code-backoff",
            "code-ready-jobs",
            "code-dead-letter",
            "code-worker-plan"
          ]
        },
        {
          "id": "genai-request-paths",
          "title": "Build GenAI request paths",
          "description": "Budget a context window, fuse ranked lists, plan overlapping chunks, and assemble evidence you are allowed to use.",
          "stepIds": [
            "code-context-budget",
            "code-rank-fusion",
            "code-chunk-plan",
            "code-evidence-packet"
          ]
        },
        {
          "id": "ml-release-decisions",
          "title": "Judge and ship a model",
          "description": "Measure a classifier honestly, split without leaking, watch for drift, and decide a release.",
          "stepIds": [
            "code-classification-metrics",
            "code-time-split",
            "code-drift-gap",
            "code-release-gate"
          ]
        },
        {
          "id": "serving-gateway",
          "title": "Put a service together",
          "description": "Build one gateway from several functions that share state, admitting work against a budget and a capacity limit.",
          "stepIds": [
            "code-inference-gateway"
          ]
        }
      ]
    },
    {
      "id": "genai",
      "title": "Generative AI",
      "subtitle": "From LLMs to agent systems",
      "description": "Understand models, build retrieval and agent systems, evaluate behavior, and operate AI in production.",
      "units": [
        {
          "id": "llm-foundations",
          "title": "Understand language models",
          "description": "Build a working mental model of tokens, transformers, and language-model behavior.",
          "lessons": [
            "llm-intro",
            "transformers",
            "llms",
            "tokenization-fundamentals",
            "bpe-algorithm",
            "production-tokenization"
          ]
        },
        {
          "id": "prompt-and-tools",
          "title": "Prompts, conversations, and tools",
          "description": "Turn model output into useful, structured application behavior.",
          "lessons": [
            "prompt-engineering",
            "conversational-ai",
            "function-calling",
            "smart-text-completion",
            "translation-systems"
          ]
        },
        {
          "id": "retrieval",
          "title": "Build with retrieval",
          "description": "Connect models to useful knowledge and choose retrieval strategies.",
          "lessons": [
            "rag-systems",
            "rag",
            "advanced-rag",
            "knowledge-graphs",
            "rag-systems-foundation",
            "rag-architecture-deep-dive",
            "vector-database-implementation"
          ]
        },
        {
          "id": "agents",
          "title": "Build agent systems",
          "description": "Connect reasoning, tools, context, and application state.",
          "lessons": [
            "langchain-production",
            "ai-agents",
            "model-context-protocol",
            "agentic-ai-systems",
            "computer-use-agents",
            "personalized-genai"
          ]
        },
        {
          "id": "model-serving",
          "title": "Serve models efficiently",
          "description": "Budget tokens, route requests, and scale inference.",
          "lessons": [
            "llm-serving",
            "token-management",
            "llm-inference-optimization",
            "ai-gateway-patterns",
            "model-serving-patterns",
            "inference-time-scaling",
            "production-transformer-architecture"
          ]
        },
        {
          "id": "model-adaptation",
          "title": "Adapt models to a task",
          "description": "Choose when and how to fine-tune a model with task-specific data.",
          "lessons": [
            "fine-tuning-practices",
            "lora-fine-tuning",
            "raft-fine-tuning"
          ]
        },
        {
          "id": "vision-and-generation",
          "title": "Vision and generation",
