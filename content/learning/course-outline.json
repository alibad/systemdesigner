            "mathematical-reasoning-benchmarks",
            "code-generation-benchmarks",
            "composite-benchmarks-mmlu",
            "lmsys-arena-evaluation"
          ]
        },
        {
          "id": "safety",
          "title": "Safety and robustness",
          "description": "Evaluate harmful behavior, adversarial inputs, bias, and truthfulness.",
          "lessons": [
            "ai-safety",
            "safety-evaluation",
            "adversarial-testing",
            "safety-evaluation-advanced",
            "toxigen-hatecheck-evaluation",
            "social-bias-measurement",
