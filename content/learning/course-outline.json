            "adversarial-robustness-evaluation"
          ]
        },
        {
          "id": "ai-operations",
          "title": "Operate AI products",
          "description": "Monitor deployed systems, defend agents, and put governance into practice.",
          "lessons": [
            "genai-monitoring",
            "production-deployment",
