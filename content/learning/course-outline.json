            "diffusion-models-production",
            "text-to-image-system-design",
            "video-generation"
          ]
        },
        {
          "id": "multimodal",
          "title": "Build multimodal systems",
          "description": "Reason about vision-language architectures, captioning, and mixtures of experts.",
          "lessons": [
            "image-captioning",
            "multimodal-ai",
            "advanced-image-captioning",
            "blip3-xgen-mm",
            "internvl3-architecture",
            "multimodal-moe-systems"
          ]
        },
        {
          "id": "document-intelligence",
          "title": "Documents and data quality",
          "description": "Extract usable information from documents and curate multimodal data.",
          "lessons": [
            "document-parsing-systems",
            "production-document-extraction",
            "laion-aesthetics"
          ]
        },
        {
          "id": "evaluation",
          "title": "Measure model behavior",
          "description": "Choose evaluation methods and build a repeatable evaluation pipeline.",
          "lessons": [
            "evaluation-benchmarks-comprehensive",
            "llm-as-judge-evaluation",
            "long-context-evaluation",
            "agentic-ai-evaluation",
            "production-evaluation-pipelines",
