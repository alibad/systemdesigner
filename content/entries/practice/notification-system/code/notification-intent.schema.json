{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systemdesigner.dev/schemas/notification-intent.json",
  "title": "Notification intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "idempotency_key",
    "event_type",
    "audience",
    "template_id",
    "template_version",
    "priority",
    "channels"
  ],
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "event_type": {
      "type": "string",
      "enum": ["security", "transactional", "product", "marketing"]
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipient_id": { "type": "string" },
        "audience_snapshot_id": { "type": "string" }
      },
      "oneOf": [
        { "required": ["recipient_id"] },
        { "required": ["audience_snapshot_id"] }
      ]
    },
    "template_id": { "type": "string" },
    "template_version": { "type": "integer", "minimum": 1 },
    "priority": {
      "type": "string",
      "enum": ["critical", "normal", "bulk"]
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["push", "email", "sms", "in_app"]
      }
    },
    "send_after": {
      "type": "string",
      "format": "date-time"
    },
    "personalization": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  }
}
