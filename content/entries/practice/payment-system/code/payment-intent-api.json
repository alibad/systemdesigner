{
  "createPaymentIntent": {
    "method": "POST",
    "path": "/v1/payment-intents",
    "headers": {
      "Idempotency-Key": "checkout-order-900-create"
    },
    "body": {
      "amountMinor": 12500,
      "currency": "USD",
      "captureMethod": "manual",
      "merchantOrderId": "order-900"
    },
    "response": {
      "id": "pi-1001",
      "status": "requires_payment_method",
      "amountMinor": 12500,
      "currency": "USD",
      "version": 0
    }
  },
  "confirmPaymentIntent": {
    "method": "POST",
    "path": "/v1/payment-intents/pi-1001/confirm",
    "headers": {
      "Idempotency-Key": "checkout-order-900-confirm"
    },
    "body": {
      "paymentMethodToken": "tok-network-7",
      "expectedVersion": 0,
      "returnUrl": "https://merchant.example/payments/return"
    },
    "response": {
      "id": "pi-1001",
      "status": "authorized",
      "providerOutcome": "approved",
      "version": 1
    }
  }
}
