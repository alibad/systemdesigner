{
  "replicaCount": 5,
  "defaults": {
    "readQuorum": 3,
    "writeQuorum": 3,
    "failedReplicas": 0
  },
  "bounds": {
    "readQuorum": { "min": 1, "max": 5, "step": 1 },
    "writeQuorum": { "min": 1, "max": 5, "step": 1 },
    "failedReplicas": { "min": 0, "max": 4, "step": 1 }
  },
  "coordinationOverheadMs": {
    "read": 2,
    "write": 4
  },
  "replicas": [
    { "id": "r1", "label": "Replica 1", "latencyMs": 4 },
    { "id": "r2", "label": "Replica 2", "latencyMs": 8 },
    { "id": "r3", "label": "Replica 3", "latencyMs": 17 },
    { "id": "r4", "label": "Replica 4", "latencyMs": 43 },
    { "id": "r5", "label": "Replica 5", "latencyMs": 86 }
  ],
  "failureScenarios": [
    {
      "failedCount": 0,
      "failedReplicaIds": [],
      "detail": "All five replicas can acknowledge."
    },
    {
      "failedCount": 1,
      "failedReplicaIds": ["r3"],
      "detail": "The 17 ms replica is unreachable."
    },
    {
      "failedCount": 2,
      "failedReplicaIds": ["r1", "r3"],
      "detail": "Two replicas are unreachable, including the fastest one."
    },
    {
      "failedCount": 3,
      "failedReplicaIds": ["r1", "r2", "r3"],
      "detail": "Only the two slowest replicas can acknowledge."
    },
    {
      "failedCount": 4,
      "failedReplicaIds": ["r1", "r2", "r3", "r4"],
      "detail": "Only one replica can acknowledge."
    }
  ]
}
