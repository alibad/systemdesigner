[
  {
    "id": "code-release-gate",
    "kind": "coding",
    "title": "Decide the release",
    "minutes": 12,
    "lessonPath": "/ml-systems/model-serving",
    "concept": "What earns a model more traffic?",
    "summary": "A canary earns exposure by clearing every floor it was given, not by winning on the average. A slice that falls below its floor blocks promotion however good the aggregate looks, and a serious regression sends traffic back to the model that was already trusted.",
    "example": "An aggregate above its floor with one language slice below it holds the canary where it is rather than promoting it.",
    "takeaway": "Read the worst slice before the average, and separate holding a release from rolling it back.",
    "instruction": "Given candidate {aggregate, slices} where slices maps a slice name to a score, floors {aggregate, slice}, rollbackDrop and exposure (a percentage), return {decision, exposure, failing}. failing lists the slice names scoring below the slice floor, sorted by name. Roll back when the aggregate falls below the aggregate floor by more than rollbackDrop, or when any slice falls below the slice floor by more than rollbackDrop; exposure becomes 0. Otherwise hold when the aggregate is below its floor or any slice is below the slice floor; exposure is unchanged. Otherwise promote and double exposure, capped at 100.",
    "hint": "Work out the failing slices once, then check the rollback condition before the hold condition. Promotion is the only branch that changes exposure upward.",
    "functionName": "decideRelease",
    "preserveInputs": true,
    "tests": [
      {
        "label": "Everything clears its floor",
        "args": [
          {
            "aggregate": 0.91,
            "slices": {
              "en": 0.9,
              "fr": 0.89
            }
          },
          {
            "aggregate": 0.85,
            "slice": 0.8
          },
          0.1,
          10
        ],
        "expected": {
          "decision": "promote",
          "exposure": 20,
          "failing": []
        }
      },
      {
        "label": "One weak slice holds the release",
        "args": [
          {
            "aggregate": 0.93,
            "slices": {
              "en": 0.94,
              "fr": 0.78
            }
          },
          {
            "aggregate": 0.85,
            "slice": 0.8
          },
          0.1,
          25
        ],
        "expected": {
          "decision": "hold",
          "exposure": 25,
          "failing": [
            "fr"
          ]
        }
      },
      {
        "label": "A collapsed slice rolls back",
        "args": [
          {
            "aggregate": 0.9,
            "slices": {
              "en": 0.91,
              "fr": 0.5
            }
          },
          {
            "aggregate": 0.85,
            "slice": 0.8
          },
          0.1,
          25
        ],
        "expected": {
          "decision": "rollback",
          "exposure": 0,
          "failing": [
            "fr"
          ]
        }
      },
      {
        "label": "A collapsed aggregate rolls back",
        "args": [
          {
            "aggregate": 0.6,
            "slices": {
              "en": 0.9
            }
          },
          {
            "aggregate": 0.85,
            "slice": 0.8
          },
          0.1,
          50
        ],
        "expected": {
          "decision": "rollback",
          "exposure": 0,
          "failing": []
        }
      },
      {
        "label": "A slightly low aggregate holds",
        "args": [
          {
            "aggregate": 0.84,
            "slices": {
              "en": 0.9
            }
          },
          {
            "aggregate": 0.85,
            "slice": 0.8
          },
          0.1,
          10
        ],
        "expected": {
          "decision": "hold",
          "exposure": 10,
          "failing": []
        }
      },
      {
        "label": "Exposure is capped at full traffic",
        "args": [
          {
            "aggregate": 0.95,
            "slices": {
              "en": 0.95
            }
          },
          {
            "aggregate": 0.85,
            "slice": 0.8
          },
          0.1,
          80
        ],
        "expected": {
          "decision": "promote",
          "exposure": 100,
          "failing": []
        }
      },
      {
        "label": "Failing slices are sorted by name",
        "args": [
          {
            "aggregate": 0.9,
            "slices": {
              "fr": 0.7,
              "de": 0.72,
              "en": 0.95
            }
          },
          {
            "aggregate": 0.85,
            "slice": 0.8
          },
          0.3,
          10
        ],
        "expected": {
          "decision": "hold",
          "exposure": 10,
          "failing": [
            "de",
            "fr"
          ]
        }
      },
      {
        "label": "A model with no slices still reads the aggregate",
        "args": [
          {
            "aggregate": 0.9,
            "slices": {}
          },
          {
            "aggregate": 0.85,
            "slice": 0.8
          },
          0.1,
          5
        ],
        "expected": {
          "decision": "promote",
          "exposure": 10,
          "failing": []
        }
      }
    ],
    "starterFile": "/api/content/ml-systems/model-serving/code/code-release-gate.js"
  }
]
