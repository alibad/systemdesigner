{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systemdesigner.dev/schemas/document-extraction-record-v1.json",
  "title": "Document extraction record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentId",
    "sourceHash",
    "schemaVersion",
    "parserVersion",
    "decision",
    "fields"
  ],
  "properties": {
    "documentId": { "type": "string", "minLength": 1 },
    "sourceHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "schemaVersion": { "const": "1.0.0" },
    "parserVersion": { "type": "string", "minLength": 1 },
    "decision": {
      "enum": ["candidate", "accepted", "review", "quarantined", "rejected"]
    },
    "fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldCandidate" }
    }
  },
  "$defs": {
    "fieldCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldId",
        "schemaPath",
        "rawText",
        "normalizedValue",
        "confidence",
        "evidence"
      ],
      "properties": {
        "fieldId": { "type": "string", "minLength": 1 },
        "schemaPath": { "type": "string", "pattern": "^/" },
        "rawText": { "type": "string" },
        "normalizedValue": {
          "type": ["string", "number", "boolean", "null"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceAnchor" }
        }
      }
    },
    "evidenceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "blockId", "polygon"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "blockId": { "type": "string", "minLength": 1 },
        "polygon": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
