{
  "title": "Decide whether a dataset candidate can ship",
  "description": "Change structural, label, slice, and privacy measurements. Repairable defects enter quarantine; critical-policy failures block release.",
  "rowCount": 100000,
  "gates": [
    {
      "id": "missing-label-rate",
      "label": "Missing label rate",
      "detail": "Rows without a usable target are routed to repair or exclusion before supervised training.",
      "direction": "maximum",
      "severity": "quarantine",
      "unit": "percent",
      "threshold": 2,
      "min": 0,
      "max": 8,
      "step": 0.2,
      "defaultValue": 1.2,
      "contributesToReviewQueue": true,
      "accent": "cyan"
    },
    {
      "id": "duplicate-rate",
      "label": "Duplicate example rate",
      "detail": "Duplicate IDs can overweight repeated behavior and leak near-identical examples across splits.",
      "direction": "maximum",
      "severity": "quarantine",
      "unit": "percent",
      "threshold": 1,
      "min": 0,
      "max": 5,
      "step": 0.2,
      "defaultValue": 0.4,
      "contributesToReviewQueue": true,
      "accent": "violet"
    },
    {
      "id": "label-agreement",
      "label": "Label agreement",
      "detail": "Low agreement is evidence of ambiguous examples, an unclear rubric, or inconsistent annotation.",
      "direction": "minimum",
      "severity": "quarantine",
      "unit": "percent",
      "threshold": 80,
      "min": 60,
      "max": 100,
      "step": 1,
      "defaultValue": 86,
      "contributesToReviewQueue": false,
      "accent": "emerald"
    },
    {
      "id": "critical-slice-coverage",
      "label": "Critical slice coverage",
      "detail": "A safety-relevant or high-cost segment needs enough reviewed examples even when aggregate volume is high.",
      "direction": "minimum",
      "severity": "block",
      "unit": "percent",
      "threshold": 70,
      "min": 20,
      "max": 100,
      "step": 2,
      "defaultValue": 74,
      "contributesToReviewQueue": false,
      "accent": "amber"
    },
    {
      "id": "restricted-records",
      "label": "Restricted records",
      "detail": "Records outside the declared allowed-use policy cannot be waived by an aggregate quality score.",
      "direction": "maximum",
      "severity": "block",
      "unit": "count",
      "threshold": 0,
      "min": 0,
      "max": 6,
      "step": 1,
      "defaultValue": 0,
      "contributesToReviewQueue": true,
      "accent": "rose"
    }
  ],
  "examples": [
    {
      "id": "candidate-pass",
      "expectedDecision": "pass",
      "metrics": {
        "missing-label-rate": 1.2,
        "duplicate-rate": 0.4,
