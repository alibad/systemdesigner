{
  "title": "Decide what the evaluation evidence supports",
  "description": "Compare illustrative evaluation runs against a use-specific gate. Missing validity evidence remains visible instead of being converted into a passing score.",
  "defaults": {
    "candidateId": "protected-balanced",
    "useCaseId": "support-assist",
    "auditModeId": "full-evidence"
  },
  "auditModes": [
    {
      "id": "score-only",
      "label": "Headline score only",
      "detail": "Inspect aggregate and slice accuracy, but no protocol or provenance evidence.",
      "reveals": []
    },
    {
      "id": "protocol-review",
      "label": "Protocol review",
      "detail": "Add prompt-variation runs and calibrated rubric agreement.",
      "reveals": [
        "promptSensitivity",
        "rubricAgreement"
      ]
    },
    {
      "id": "full-evidence",
      "label": "Full evidence review",
      "detail": "Add item provenance and near-duplicate contamination checks.",
      "reveals": [
        "promptSensitivity",
        "rubricAgreement",
        "contamination"
      ]
    }
  ],
  "useCases": [
    {
      "id": "exploration",
