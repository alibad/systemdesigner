{
  "title": "Build a knowledge evidence blueprint",
  "description": "Choose the claim, portfolio strategy, and item budget. The matrix preserves the exact budget and exposes cells that are too thin to support the claim.",
  "defaults": {
    "claimId": "support-copilot",
    "policyId": "claim-aligned",
    "itemBudget": 800
  },
  "minimums": {
    "standardCellItems": 20,
    "criticalCellItems": 40
  },
  "operations": [
    {
      "id": "recall",
      "label": "Recall",
      "detail": "Retrieve a fact, term, or rule without supplied evidence."
    },
    {
      "id": "explain",
      "label": "Explain",
      "detail": "Connect facts and state why a mechanism or rule applies."
    },
    {
      "id": "apply",
      "label": "Apply",
      "detail": "Use knowledge in a new, constrained case."
    },
    {
      "id": "source",
      "label": "Source",
      "detail": "Use or cite the supplied evidence and respect its date."
    }
  ],
  "policies": [
    {
      "id": "claim-aligned",
      "label": "Claim-aligned",
      "detail": "Preserve the operation mix required by the intended use.",
      "operationMultipliers": {
        "recall": 1,
        "explain": 1,
        "apply": 1,
        "source": 1
      }
    },
    {
      "id": "recall-heavy",
      "label": "Recall-heavy",
      "detail": "Favor cheap multiple-choice coverage, risking weak transfer evidence.",
      "operationMultipliers": {
        "recall": 2.4,
        "explain": 0.8,
        "apply": 0.45,
        "source": 0.35
      }
    },
    {
      "id": "application-heavy",
      "label": "Application-heavy",
      "detail": "Invest in scenarios and evidence use, with less breadth of direct recall.",
      "operationMultipliers": {
        "recall": 0.55,
        "explain": 0.9,
        "apply": 1.8,
        "source": 1.5
      }
    }
  ],
  "claims": [
    {
      "id": "general-assistant",
      "label": "General knowledge assistant",
      "detail": "Broad, low-stakes questions across several public-information domains.",
      "operationWeights": {
        "recall": 35,
        "explain": 30,
        "apply": 20,
        "source": 15
      },
      "domains": [
        {
          "id": "science",
          "label": "Science",
          "weight": 25
        },
        {
          "id": "technology",
          "label": "Technology",
          "weight": 25
        },
        {
          "id": "history",
          "label": "History",
          "weight": 20
        },
        {
          "id": "civics",
          "label": "Civics",
          "weight": 15
        },
        {
