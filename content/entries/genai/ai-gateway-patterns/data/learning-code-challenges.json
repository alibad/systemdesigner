[
  {
    "id": "code-inference-gateway",
    "kind": "coding",
    "title": "Build an inference gateway",
    "minutes": 15,
    "lessonPath": "/genai/ai-gateway-patterns",
    "concept": "What does a gateway own?",
    "summary": "A gateway sits in front of a model and decides which requests may proceed. It holds two limits at once: how much each tenant may spend, and how many requests may be in flight together. A request that is turned away has to say which limit turned it away, and a request that finishes has to give its slot back.",
    "example": "A tenant at its token budget is refused for budget, while a request arriving at full capacity is refused for capacity even though its tenant has budget left.",
    "takeaway": "Admission reserves a slot and completion returns it, so a gateway that forgets to release stops admitting anything.",
    "instruction": "Build four functions that share state. configure(budgets, capacity) starts a gateway where budgets maps tenant to a token budget and capacity is the number of requests allowed in flight; it returns the starting report. admit(tenant, tokens) returns {admitted, reason}: refuse with reason 'unknown' for a tenant with no budget, 'capacity' when in-flight requests already equal capacity, and 'budget' when the tenant's committed tokens plus tokens would exceed its budget; check unknown, then capacity, then budget. On success return {admitted: true, reason: null}, commit the tokens and take an in-flight slot. complete(tenant, tokens) releases one in-flight slot and returns the tenant's committed tokens; ignore a tenant that has nothing in flight. report() returns {inFlight, used, rejected} where used maps tenant to committed tokens and rejected counts refusals by reason as {unknown, capacity, budget}.",
    "hint": "Keep the budgets, committed tokens, in-flight count and rejection counts in variables the four functions close over. Reserve the slot at admission and release it at completion.",
    "functionName": "admit",
    "exports": [
      "configure",
      "admit",
      "complete",
      "report"
    ],
    "preserveInputs": true,
    "starterFile": "/api/content/genai/ai-gateway-patterns/code/code-inference-gateway.js",
    "tests": [
      {
        "label": "A first request is admitted and committed",
        "calls": [
          {
            "fn": "configure",
            "args": [
              {
                "acme": 1000
              },
              2
            ]
          },
          {
            "fn": "admit",
