[
  {
    "id": "code-evidence-packet",
    "kind": "coding",
    "title": "Assemble an evidence packet",
    "minutes": 12,
    "lessonPath": "/genai/rag",
    "concept": "What does context assembly owe the answer?",
    "summary": "Context assembly decides what a grounded answer is allowed to use. Passages the requester may not see, passages that have expired, and repeats of a source already included are all removed before anything competes for the token budget. When nothing survives, the system abstains rather than answering unsupported.",
    "example": "Two passages from the same document collapse to the better-ranked one, and an expired passage never reaches the prompt.",
    "takeaway": "Authorization and freshness are filters, not ranking signals, and an empty packet is a refusal rather than a smaller answer.",
    "instruction": "Given passages [{id, source, tokens, tenant, expiresAt}] ordered best first, plus tenant, now and budgetTokens, return {packet, usedTokens, refused}. Drop a passage whose tenant differs from the requester, whose expiresAt is less than or equal to now, or whose source already appears in the packet. Then take the remaining passages in order while they fit the budget, stopping at the first that does not. packet is the kept IDs in order. refused is true when the packet is empty.",
    "hint": "Filter for authorization, freshness and duplicate sources first, then fit what survives into the budget. Deduplicate by source, not by passage id.",
    "functionName": "assemblePacket",
    "preserveInputs": true,
    "tests": [
      {
        "label": "Keeps the best passage per source within budget",
        "args": [
          [
            {
              "id": "p1",
              "source": "doc-a",
              "tokens": 100,
              "tenant": "acme",
              "expiresAt": 50
            },
            {
              "id": "p2",
              "source": "doc-a",
              "tokens": 100,
              "tenant": "acme",
              "expiresAt": 50
            },
            {
              "id": "p3",
              "source": "doc-b",
              "tokens": 100,
              "tenant": "acme",
              "expiresAt": 50
            }
          ],
          "acme",
          10,
          300
        ],
        "expected": {
          "packet": [
            "p1",
            "p3"
          ],
          "usedTokens": 200,
          "refused": false
        }
      },
      {
        "label": "Another tenant's passage never enters the packet",
        "args": [
          [
            {
              "id": "p1",
              "source": "doc-a",
              "tokens": 100,
              "tenant": "globex",
              "expiresAt": 50
            },
            {
              "id": "p2",
              "source": "doc-b",
              "tokens": 100,
              "tenant": "acme",
              "expiresAt": 50
            }
          ],
          "acme",
          10,
          300
        ],
        "expected": {
          "packet": [
            "p2"
          ],
          "usedTokens": 100,
          "refused": false
        }
      },
      {
        "label": "Expired passages are dropped",
        "args": [
          [
            {
              "id": "p1",
              "source": "doc-a",
              "tokens": 100,
              "tenant": "acme",
              "expiresAt": 10
            },
            {
              "id": "p2",
              "source": "doc-b",
              "tokens": 100,
              "tenant": "acme",
              "expiresAt": 11
            }
          ],
          "acme",
          10,
          300
        ],
        "expected": {
          "packet": [
            "p2"
          ],
          "usedTokens": 100,
          "refused": false
        }
      },
      {
        "label": "An empty packet is a refusal",
        "args": [
          [
            {
              "id": "p1",
              "source": "doc-a",
              "tokens": 100,
              "tenant": "globex",
              "expiresAt": 50
            }
          ],
          "acme",
          10,
          300
        ],
        "expected": {
          "packet": [],
          "usedTokens": 0,
          "refused": true
        }
      },
      {
        "label": "The budget stops at the first passage that does not fit",
        "args": [
          [
            {
              "id": "p1",
              "source": "doc-a",
              "tokens": 100,
              "tenant": "acme",
              "expiresAt": 50
            },
            {
              "id": "p2",
              "source": "doc-b",
              "tokens": 250,
              "tenant": "acme",
              "expiresAt": 50
            },
            {
              "id": "p3",
              "source": "doc-c",
              "tokens": 50,
              "tenant": "acme",
              "expiresAt": 50
            }
          ],
          "acme",
          10,
          300
        ],
        "expected": {
          "packet": [
            "p1"
          ],
          "usedTokens": 100,
          "refused": false
        }
      },
      {
        "label": "No passages refuses",
        "args": [
          [],
          "acme",
          10,
          300
        ],
        "expected": {
          "packet": [],
          "usedTokens": 0,
          "refused": true
        }
      },
      {
        "label": "A zero budget refuses even with eligible evidence",
        "args": [
          [
            {
              "id": "p1",
              "source": "doc-a",
              "tokens": 10,
              "tenant": "acme",
              "expiresAt": 50
            }
          ],
          "acme",
          10,
          0
        ],
        "expected": {
          "packet": [],
          "usedTokens": 0,
          "refused": true
        }
      }
    ],
    "starterFile": "/api/content/genai/rag/code/code-evidence-packet.js"
  }
]
