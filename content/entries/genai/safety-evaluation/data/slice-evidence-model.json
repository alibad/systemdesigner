{
  "title": "Allocate evidence where harm can hide",
  "description": "Distribute a fixed evaluation budget across product slices. Compare traffic-proportional sampling with equal and severity-weighted plans, then inspect whether each slice has enough cases and human calibration to support a claim.",
  "defaults": {
    "productId": "global-support",
    "policyId": "traffic",
    "evaluationBudget": 1200,
    "humanReviewPct": 12
  },
  "requirements": {
    "minimumCasesBySeverity": {
      "moderate": 120,
      "high": 180,
      "critical": 260
    },
    "minimumHumanReviewsBySeverity": {
      "moderate": 18,
      "high": 32,
      "critical": 52
    },
    "maximumMarginPctBySeverity": {
      "moderate": 5,
      "high": 4,
      "critical": 3
    }
  },
  "policies": [
    {
      "id": "traffic",
      "label": "Traffic proportional",
      "detail": "Mirrors production volume. Efficient for common use, but rare high-impact slices receive little evidence."
    },
    {
      "id": "equal",
      "label": "Equal by slice",
      "detail": "Gives every declared slice the same case count, regardless of prevalence or impact."
    },
    {
      "id": "severity",
      "label": "Severity weighted",
      "detail": "Oversamples rare slices when a miss can cause greater or less reversible harm."
    }
  ],
