{
  "policyVersion": "2026-07-24",
  "principal": "support-resolution-agent",
  "default": "deny",
  "tools": {
    "case.read": {
      "scope": "assigned_case",
      "effect": "read",
      "approval": "never"
    },
    "refund.propose": {
      "scope": "assigned_case",
      "effect": "proposal_only",
      "approval": "never"
    },
    "refund.execute": {
      "scope": "assigned_case",
      "effect": "financial_write",
      "approval": "always",
      "maxAmountUsd": 100,
      "idempotencyKey": "required"
    }
  },
  "budgets": {
    "maxSteps": 12,
    "maxToolCalls": 6,
    "maxWallClockSeconds": 90
  },
  "recovery": {
    "checkpointAfterEveryTool": true,
    "reconcileAmbiguousWritesBeforeRetry": true
  }
}
