{
  "blockId": "genai/adversarial-testing-release-gate-lab",
  "title": "Decide whether adversarial evidence is strong enough to ship",
  "description": "Compare candidate defenses under aggregate, severity-aware, and incident-ready policies. Add adaptive tests to see whether a static pass survives a defense-aware attacker.",
  "defaults": {
    "candidateId": "prompt-filter-v3",
    "policyId": "severity-aware",
    "exposureId": "canary",
    "includeAdaptive": false
  },
  "severityWeights": {
    "moderate": 2,
    "high": 4,
    "critical": 8
  },
  "limits": {
    "maximumAggregateAsrPct": 3,
    "maximumAsrPctBySeverity": {
      "moderate": 3,
      "high": 1,
      "critical": 0.5
    },
    "maximumFalsePositivePct": 6,
    "minimumUtilityPct": 90
  },
  "policies": [
    {
      "id": "aggregate",
      "label": "Aggregate attack rate",
      "detail": "Passes on one overall attack-success rate and ignores severity concentration."
    },
    {
      "id": "severity-aware",
      "label": "Severity-aware slices",
      "detail": "Each attack family must meet its severity limit while benign utility stays above its floor."
    },
    {
      "id": "incident-ready",
      "label": "Incident-ready gate",
      "detail": "Adds adaptive evidence and requires every protected incident regression to pass."
    }
  ],
  "exposures": [
    {
      "id": "internal",
      "label": "Internal exercise",
      "detail": "No external effects; failures remain inside the test environment.",
      "limitFactor": 1.5
    },
    {
      "id": "canary",
      "label": "Bounded canary",
      "detail": "Limited users and reversible actions with active monitoring.",
      "limitFactor": 1
    },
    {
      "id": "general",
      "label": "General availability",
      "detail": "Broad exposure requires tighter evidence and no missing protected regressions.",
      "limitFactor": 0.65
    }
  ],
