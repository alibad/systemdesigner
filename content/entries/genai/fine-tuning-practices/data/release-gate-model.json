{
  "blockId": "genai/fine-tuning-practices-release-gate-lab",
  "title": "Release the best checkpoint, not merely the last one",
  "description": "Inspect illustrative held-out evidence, overfitting signals, lineage, and serving compatibility. The fixture metrics teach gate logic; they are not benchmark claims.",
  "defaults": {
    "runId": "lora-conservative",
    "checkpointId": "lora-c2",
    "runtimeId": "adapter-runtime-v3",
    "policyId": "standard"
  },
  "policies": [
    {
      "id": "standard",
      "label": "Standard product gate",
      "detail": "Balanced gate for a reversible internal workflow.",
      "minimumTaskScore": 88,
      "minimumRareSliceScore": 82,
      "minimumSafetyScore": 97,
      "maximumBaseRegressionPp": 2,
      "maximumLossGap": 0.18
    },
    {
      "id": "high-assurance",
      "label": "High-assurance gate",
      "detail": "Tighter slice, safety, and regression limits for consequential output.",
      "minimumTaskScore": 91,
      "minimumRareSliceScore": 88,
      "minimumSafetyScore": 99,
      "maximumBaseRegressionPp": 0.8,
      "maximumLossGap": 0.1
    }
  ],
  "runs": [
