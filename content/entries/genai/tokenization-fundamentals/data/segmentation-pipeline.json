{
  "title": "Trace a teaching tokenizer contract",
  "description": "Choose an input, normalization result, segmentation model, and trusted wrapper. Inspect the exact bytes, token IDs, and UTF-16 offsets in each fixed fixture.",
  "disclaimer": "These are intentionally small teaching vocabularies. Their pieces and IDs are illustrative and do not match a vendor tokenizer.",
  "offsetUnit": "UTF-16 code units in normalized text",
  "defaults": {
    "sampleId": "unicode-accent",
    "variantId": "preserve",
    "profileId": "merge",
    "addTrustedWrapper": false
  },
  "profiles": [
    {
      "id": "merge",
      "label": "Ranked merges",
      "detail": "A BPE-like fixture repeatedly applies saved high-priority adjacent merges.",
      "method": "Merge rules reward frequent adjacent byte-backed symbols.",
      "startToken": {
        "piece": "<|user|>",
        "id": 90001
      },
      "endToken": {
        "piece": "<|end|>",
        "id": 90002
      }
    },
    {
      "id": "unigram",
      "label": "Scored pieces",
      "detail": "A unigram-style fixture chooses a high-scoring complete path through candidate pieces.",
      "method": "Piece scores compete globally; a locally long piece is not always the best path.",
      "startToken": {
        "piece": "<user>",
        "id": 70001
      },
      "endToken": {
        "piece": "</turn>",
        "id": 70002
      }
    }
  ],
