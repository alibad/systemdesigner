PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX ex: <https://example.com/catalog/>

SELECT ?dataset ?title
FROM <https://example.com/graphs/approved>
WHERE {
  VALUES ?catalog { ex:finance ex:risk }
  ?catalog dcat:dataset ?dataset .
  ?dataset dcat:title ?title ;
           dcat:theme ex:customer-risk .
}
ORDER BY ?title
LIMIT 100
