{
  "title": "Keep the evidence that answers incident questions",
  "description": "Choose a synthetic workload and retention policy. The lab computes raw and retained events from explicit rates and byte sizes; it does not estimate Datadog pricing.",
  "defaults": {
    "workloadId": "checkout-api",
    "retentionPolicyId": "protect-failures",
    "healthyLogRetentionPercent": 20,
    "healthyTraceSamplePercent": 10
  },
  "bounds": {
    "healthyLogRetentionPercent": {
      "min": 1,
      "max": 100,
      "step": 1
    },
    "healthyTraceSamplePercent": {
      "min": 1,
      "max": 100,
      "step": 1
    }
  },
  "workloads": [
    {
      "id": "checkout-api",
      "label": "Checkout API",
      "detail": "2,500 req/s, 1.2% failures, 3 logs/request, 8 spans/trace.",
      "requestsPerSecond": 2500,
      "errorPercent": 1.2,
      "logsPerRequest": 3,
      "bytesPerLog": 700,
      "spansPerTrace": 8,
      "bytesPerSpan": 500
    },
    {
      "id": "payments-api",
      "label": "Payments API",
      "detail": "800 req/s, 0.4% failures, 5 logs/request, 12 spans/trace.",
      "requestsPerSecond": 800,
      "errorPercent": 0.4,
      "logsPerRequest": 5,
      "bytesPerLog": 900,
      "spansPerTrace": 12,
      "bytesPerSpan": 550
    },
    {
      "id": "catalog-api",
      "label": "Catalog API",
      "detail": "12,000 req/s, 0.2% failures, 2 logs/request, 5 spans/trace.",
      "requestsPerSecond": 12000,
      "errorPercent": 0.2,
      "logsPerRequest": 2,
      "bytesPerLog": 600,
      "spansPerTrace": 5,
      "bytesPerSpan": 450
    }
  ],
  "retentionPolicies": [
    {
      "id": "protect-failures",
      "label": "Protect failure paths",
      "detail": "Keep every modeled error log and error trace; sample routine traffic separately.",
      "retainFailureLogs": true,
      "retainFailureTraces": true
    },
    {
      "id": "uniform-sampling",
      "label": "Sample everything uniformly",
      "detail": "Apply the routine percentages to failures too, making incident evidence probabilistic.",
      "retainFailureLogs": false,
      "retainFailureTraces": false
    },
    {
      "id": "logs-only-protection",
      "label": "Protect only failure logs",
      "detail": "Keep error logs, but sample failure traces at the same rate as healthy requests.",
      "retainFailureLogs": true,
      "retainFailureTraces": false
    }
  ]
}
