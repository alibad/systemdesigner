{
  "size": 20,
  "track_total_hits": false,
  "_source": ["product_id", "title", "price", "category"],
  "query": {
    "bool": {
      "must": [
        {
          "match": {
            "title": {
              "query": "wireless headphones",
              "operator": "and"
            }
          }
        }
      ],
      "filter": [
        { "term": { "available": true } },
        { "term": { "category": "audio" } },
        { "range": { "price": { "gte": 50, "lte": 300 } } }
      ]
    }
  },
  "sort": [
    { "_score": "desc" },
    { "product_id": "asc" }
  ],
  "aggs": {
    "categories": {
      "terms": { "field": "category", "size": 12 }
    }
  }
}
