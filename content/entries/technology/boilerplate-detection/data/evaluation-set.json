{
  "title": "Set the extraction threshold from labeled evidence",
  "description": "Move the score threshold and change the evaluation slice. The same extractor can become cleaner or more complete, but it cannot maximize precision and recall independently.",
  "defaults": {
    "goalId": "balanced",
    "sliceId": "all"
  },
  "goals": [
    {
      "id": "clean-summaries",
      "label": "Clean summaries",
      "detail": "Prefer fewer false inclusions when extracted text is shown directly to readers.",
      "threshold": 80,
      "priorityMetric": "precision"
    },
    {
      "id": "balanced",
      "label": "Balanced extraction",
      "detail": "Trade some missed blocks for a practical balance between noise and coverage.",
      "threshold": 65,
      "priorityMetric": "f1"
    },
    {
      "id": "corpus-coverage",
      "label": "Corpus coverage",
      "detail": "Prefer fewer missing content blocks when downstream review can tolerate extra cleanup.",
      "threshold": 50,
      "priorityMetric": "recall"
    }
  ],
