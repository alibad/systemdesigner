{
  "description": "Stop and restart one tagged checkout instance",
  "targets": {
    "oneCheckoutInstance": {
      "resourceType": "aws:ec2:instance",
      "resourceTags": {
        "service": "checkout",
        "chaos-ready": "true"
      },
      "selectionMode": "COUNT(1)"
    }
  },
  "actions": {
    "stopOneInstance": {
      "actionId": "aws:ec2:stop-instances",
      "description": "Stop one checkout instance and restart it after two minutes",
      "parameters": {
        "startInstancesAfterDuration": "PT2M"
      },
      "targets": {
        "Instances": "oneCheckoutInstance"
      }
    }
  },
  "stopConditions": [
    {
      "source": "aws:cloudwatch:alarm",
      "value": "arn:aws:cloudwatch:us-east-1:111122223333:alarm:checkout-chaos-abort"
    }
  ],
  "roleArn": "arn:aws:iam::111122223333:role/checkout-fis-experiment",
  "tags": {
    "owner": "checkout-sre",
    "experiment": "single-instance-loss"
  }
}
