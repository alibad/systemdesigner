{
  "title": "Contain a rollout with inventory and batch policy",
  "description": "Select a real inventory expression, then tune serial and max_fail_percentage. Inject failures into the first batch to see which hosts change and which remain protected.",
  "defaults": {
    "patternId": "production",
    "serial": 3,
    "maxFailPercentage": 33,
    "failedHosts": 1
  },
  "hosts": [
    {
      "id": "web-prod-a1",
      "label": "web-a1",
      "environment": "production",
      "zone": "zone-a",
      "groups": ["webservers", "production", "canary"]
    },
    {
      "id": "web-prod-a2",
      "label": "web-a2",
      "environment": "production",
      "zone": "zone-a",
      "groups": ["webservers", "production"]
    },
    {
      "id": "web-prod-b1",
      "label": "web-b1",
      "environment": "production",
      "zone": "zone-b",
      "groups": ["webservers", "production", "canary"]
    },
    {
      "id": "web-prod-b2",
      "label": "web-b2",
      "environment": "production",
      "zone": "zone-b",
      "groups": ["webservers", "production"]
    },
    {
      "id": "web-prod-c1",
      "label": "web-c1",
      "environment": "production",
      "zone": "zone-c",
      "groups": ["webservers", "production"]
    },
    {
      "id": "web-prod-c2",
      "label": "web-c2",
      "environment": "production",
      "zone": "zone-c",
      "groups": ["webservers", "production"]
    },
    {
      "id": "web-stage-a1",
      "label": "stage-a1",
      "environment": "staging",
      "zone": "zone-a",
      "groups": ["webservers", "staging"]
    },
    {
      "id": "web-stage-b1",
      "label": "stage-b1",
      "environment": "staging",
      "zone": "zone-b",
      "groups": ["webservers", "staging"]
    }
  ],
  "patterns": [
    {
      "id": "canary",
      "label": "Production canaries",
      "expression": "webservers:&production:&canary",
      "detail": "Two reviewed production hosts, one in zone-a and one in zone-b.",
      "matchedHostIds": ["web-prod-a1", "web-prod-b1"]
    },
    {
      "id": "production",
      "label": "All production web servers",
      "expression": "webservers:&production",
      "detail": "All six production web servers; staging remains outside the target set.",
      "matchedHostIds": [
        "web-prod-a1",
        "web-prod-a2",
        "web-prod-b1",
        "web-prod-b2",
        "web-prod-c1",
        "web-prod-c2"
      ]
    },
    {
      "id": "non-canary",
      "label": "Production except canaries",
      "expression": "webservers:&production:!canary",
      "detail": "The four production hosts that are not members of the canary group.",
      "matchedHostIds": ["web-prod-a2", "web-prod-b2", "web-prod-c1", "web-prod-c2"]
    },
    {
      "id": "broad",
      "label": "Every web server",
      "expression": "webservers",
      "detail": "A dangerously broad expression that also includes both staging hosts.",
      "matchedHostIds": [
        "web-prod-a1",
        "web-prod-a2",
        "web-prod-b1",
        "web-prod-b2",
        "web-prod-c1",
        "web-prod-c2",
        "web-stage-a1",
        "web-stage-b1"
      ]
    }
  ]
}
