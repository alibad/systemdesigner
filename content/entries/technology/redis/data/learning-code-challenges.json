[
  {
    "id": "code-cache-ttl",
    "kind": "coding",
    "title": "Read a cache with expiry",
    "minutes": 6,
    "lessonPath": "/technology/redis",
    "concept": "What is a time to live?",
    "summary": "A time to live limits how long a cached value remains usable. Expiration is a boundary decision: a record whose expiry equals the current time is already expired.",
    "example": "At now=100, an entry expiring at 101 is usable; one expiring at 100 is not.",
    "takeaway": "Check key existence and expiration separately from the cached value.",
    "instruction": "Return {hit: true, value} when cache has its own key and expiresAt > now. Otherwise return {hit: false, value: null}. Cached false, 0, and null are valid hits.",
    "hint": "Check key existence and expiration separately from the cached value.",
    "starterFile": "/api/content/technology/redis/code/code-cache-ttl.js",
    "functionName": "readCache",
    "tests": [
      {
        "label": "Fresh entry",
        "args": [
          {
            "a": {
              "value": "data",
              "expiresAt": 101
            }
          },
          "a",
          100
        ],
        "expected": {
          "hit": true,
          "value": "data"
        }
      },
      {
        "label": "Expiry boundary",
        "args": [
          {
            "a": {
              "value": 1,
              "expiresAt": 100
            }
          },
          "a",
          100
        ],
        "expected": {
          "hit": false,
          "value": null
        }
      },
      {
        "label": "Falsy hit",
        "args": [
          {
            "a": {
              "value": false,
              "expiresAt": 200
            }
          },
          "a",
          100
        ],
        "expected": {
          "hit": true,
          "value": false
        }
      },
      {
        "label": "Missing entry",
        "args": [
          {},
          "constructor",
          100
        ],
        "expected": {
          "hit": false,
          "value": null
        }
      },
      {
        "label": "Null is a hit",
        "args": [
          {
            "a": {
              "value": null,
              "expiresAt": 200
            }
          },
          "a",
          100
        ],
        "expected": {
          "hit": true,
          "value": null
        }
      }
    ]
  }
]
