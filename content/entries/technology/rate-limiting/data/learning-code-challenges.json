[
  {
    "id": "code-fixed-window",
    "kind": "coding",
    "title": "Apply a fixed-window limit",
    "minutes": 6,
    "lessonPath": "/technology/rate-limiting",
    "concept": "What is a fixed-window rate limit?",
    "summary": "A fixed-window limiter counts requests in a time bucket. Requests in a new bucket start with a fresh count; rejected requests do not consume another slot.",
    "example": "A count of 2 with a limit of 3 accepts one request and returns a count of 3.",
    "takeaway": "Decide the effective count first, then increment only when accepting.",
    "instruction": "Given {window, count}, the current integer window, and a positive integer limit, return {allowed, state}. Reset count when the window changes. Never mutate the input state.",
    "hint": "Decide the effective count first, then increment only when accepting.",
    "starterFile": "/api/content/technology/rate-limiting/code/code-fixed-window.js",
    "functionName": "fixedWindow",
    "tests": [
      {
        "label": "Accept last slot",
        "args": [
          {
            "window": 1,
            "count": 2
          },
          1,
          3
        ],
        "expected": {
          "allowed": true,
          "state": {
            "window": 1,
            "count": 3
          }
        }
      },
      {
        "label": "Reject full window",
        "args": [
          {
            "window": 1,
            "count": 3
          },
          1,
          3
        ],
        "expected": {
          "allowed": false,
          "state": {
            "window": 1,
            "count": 3
          }
        }
      },
      {
        "label": "Reset new window",
        "args": [
          {
            "window": 1,
            "count": 9
          },
          2,
          3
        ],
        "expected": {
          "allowed": true,
          "state": {
            "window": 2,
            "count": 1
          }
        }
      },
      {
        "label": "One slot",
        "args": [
          {
            "window": 0,
            "count": 0
          },
          0,
          1
        ],
        "expected": {
          "allowed": true,
          "state": {
            "window": 0,
            "count": 1
          }
        }
      }
    ]
  },
  {
    "id": "code-token-bucket",
    "kind": "coding",
    "title": "Refill a token bucket",
    "minutes": 6,
    "lessonPath": "/technology/rate-limiting",
    "concept": "What is a token bucket?",
    "summary": "A token bucket accumulates permission to perform work at a fixed rate, up to a capacity. A request consumes tokens only when enough are available.",
    "example": "Two tokens plus three seconds at two tokens per second refill to eight, before applying a capacity cap.",
    "takeaway": "Cap after refilling. A rejected request keeps the refilled balance.",
    "instruction": "For nonnegative numeric inputs and positive capacity, refill tokens by elapsedSeconds * refillPerSecond, cap at capacity, then spend cost if affordable. Return {allowed, tokens}.",
    "hint": "Cap after refilling. A rejected request keeps the refilled balance.",
    "starterFile": "/api/content/technology/rate-limiting/code/code-token-bucket.js",
    "functionName": "tokenBucket",
    "tests": [
      {
        "label": "Refill then spend",
        "args": [
          2,
          3,
          2,
          10,
          4
        ],
        "expected": {
          "allowed": true,
          "tokens": 4
        }
      },
      {
        "label": "Cap bursts",
        "args": [
          8,
          10,
          2,
          10,
          3
        ],
        "expected": {
          "allowed": true,
          "tokens": 7
        }
      },
      {
        "label": "Insufficient tokens",
        "args": [
          0,
          1,
          1,
          5,
          2
        ],
        "expected": {
          "allowed": false,
          "tokens": 1
        }
      },
      {
        "label": "Exact balance",
        "args": [
          3,
          0,
          1,
          5,
          3
        ],
        "expected": {
          "allowed": true,
          "tokens": 0
        }
      }
    ]
  },
