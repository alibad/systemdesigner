    "title": "Count a sliding window",
    "minutes": 6,
    "lessonPath": "/technology/rate-limiting",
    "concept": "What is a sliding time window?",
    "summary": "A sliding window follows the current time instead of resetting at fixed boundaries. Defining its endpoints prevents off-by-one errors at expiration.",
    "example": "For now=100 and width=10, timestamps greater than 90 and at most 100 count.",
    "takeaway": "Use a strict lower bound and an inclusive upper bound.",
    "instruction": "Count timestamps in the interval (now - width, now]. Inputs use a positive numeric width. Ignore future timestamps.",
    "hint": "Use a strict lower bound and an inclusive upper bound.",
    "starterFile": "/api/content/technology/rate-limiting/code/code-sliding-window.js",
    "functionName": "countRecent",
    "tests": [
      {
        "label": "Window boundaries",
        "args": [
          [
            89,
            90,
            91,
            100,
            101
          ],
          100,
          10
        ],
        "expected": 2
      },
      {
        "label": "Empty history",
        "args": [
          [],
          100,
          10
        ],
        "expected": 0
      },
      {
        "label": "Duplicates are requests",
        "args": [
          [
