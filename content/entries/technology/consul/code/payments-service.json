{
  "service": {
    "id": "payments-1",
    "name": "payments",
    "port": 8080,
    "tags": [
      "v2"
    ],
    "meta": {
      "owner": "payments-platform",
      "release": "2026-07-24"
    },
    "connect": {
      "sidecar_service": {}
    },
    "check": {
      "id": "payments-readiness",
      "name": "Payments API readiness",
      "http": "http://127.0.0.1:8080/ready",
      "interval": "10s",
      "timeout": "2s",
      "failures_before_critical": 3,
      "success_before_passing": 2,
      "deregister_critical_service_after": "30m"
    }
  }
}
