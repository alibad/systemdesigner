{
  "datacenter": "dc1",
  "data_dir": "/opt/consul",
  "server": true,
  "bootstrap_expect": 3,
  "retry_join": [
    "provider=aws tag_name=consul-server tag_value=true"
  ],
  "encrypt": "<gossip-key-from-secret-manager>",
  "connect": {
    "enabled": true
  },
  "acl": {
    "enabled": true,
    "default_policy": "deny",
    "enable_token_persistence": true
  },
  "tls": {
    "defaults": {
      "ca_file": "/etc/consul.d/tls/consul-agent-ca.pem",
      "cert_file": "/etc/consul.d/tls/dc1-server-consul-0.pem",
      "key_file": "/etc/consul.d/tls/dc1-server-consul-0-key.pem",
      "verify_incoming": true,
      "verify_outgoing": true
    },
    "internal_rpc": {
      "verify_server_hostname": true
    }
  }
}
