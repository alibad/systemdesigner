# Request rate, preserving the service dimension.
sum by (service) (
  rate(http_requests_total{job="api"}[5m])
)

# Error ratio only when the service has meaningful traffic.
(
  sum by (service) (
    rate(http_requests_total{job="api", status=~"5.."}[5m])
  )
/
  sum by (service) (
    rate(http_requests_total{job="api"}[5m])
  )
)
and on (service)
sum by (service) (
  rate(http_requests_total{job="api"}[5m])
) > 1

# p95 latency from classic histogram buckets.
histogram_quantile(
  0.95,
  sum by (le, service) (
    rate(http_request_duration_seconds_bucket{job="api"}[5m])
  )
)

# Targets currently failing their scrape.
up{job="api"} == 0

# Prometheus ingestion and remote-write pressure.
prometheus_tsdb_head_series
prometheus_remote_storage_samples_pending
