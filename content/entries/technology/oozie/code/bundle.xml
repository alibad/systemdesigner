<?xml version="1.0" encoding="UTF-8"?>
<bundle-app name="orders-platform"
            xmlns="uri:oozie:bundle:0.2">
    <parameters>
        <property><name>ordersCoordinatorPath</name></property>
        <property><name>qualityCoordinatorPath</name></property>
        <property><name>environment</name></property>
    </parameters>

    <coordinator name="orders-daily">
        <app-path>${ordersCoordinatorPath}</app-path>
        <configuration>
            <property>
                <name>environment</name>
                <value>${environment}</value>
            </property>
        </configuration>
    </coordinator>

    <coordinator name="orders-quality">
        <app-path>${qualityCoordinatorPath}</app-path>
        <configuration>
            <property>
                <name>environment</name>
                <value>${environment}</value>
            </property>
        </configuration>
    </coordinator>
</bundle-app>
