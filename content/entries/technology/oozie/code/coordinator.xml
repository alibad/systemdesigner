<?xml version="1.0" encoding="UTF-8"?>
<coordinator-app name="daily-orders"
                 frequency="${coord:days(1)}"
                 start="${startTime}"
                 end="${endTime}"
                 timezone="UTC"
                 xmlns="uri:oozie:coordinator:0.5">
    <parameters>
        <property><name>startTime</name></property>
        <property><name>endTime</name></property>
        <property><name>workflowPath</name></property>
        <property>
            <name>outputRoot</name>
            <value>hdfs:///warehouse/orders</value>
        </property>
    </parameters>

    <controls>
        <timeout>${coord:hours(6)}</timeout>
        <concurrency>2</concurrency>
        <execution>FIFO</execution>
    </controls>

    <datasets>
        <dataset name="orders"
                 frequency="${coord:days(1)}"
                 initial-instance="${datasetStart}"
                 timezone="UTC">
            <uri-template>
                hdfs:///landing/orders/${YEAR}/${MONTH}/${DAY}
            </uri-template>
        </dataset>
    </datasets>

    <input-events>
        <data-in name="ordersInput" dataset="orders">
            <instance>${coord:current(0)}</instance>
        </data-in>
    </input-events>

    <action>
        <workflow>
            <app-path>${workflowPath}</app-path>
            <configuration>
                <property>
                    <name>inputPath</name>
                    <value>${coord:dataIn('ordersInput')}</value>
                </property>
                <property>
                    <name>outputPath</name>
                    <value>${outputRoot}/dt=${coord:formatTime(coord:nominalTime(), 'yyyy-MM-dd')}</value>
                </property>
            </configuration>
        </workflow>
    </action>
</coordinator-app>
