      "detail": "The original writer grouped files by event day."
    },
    {
      "id": 1,
      "label": "Spec 1",
      "fields": [
        "hour(event_time)",
        "identity(region)"
      ],
      "detail": "New writers add hourly and regional pruning; old files stay under spec 0."
    }
  ],
  "snapshots": [
