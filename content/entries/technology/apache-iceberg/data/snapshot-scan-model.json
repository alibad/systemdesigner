  "queries": [
    {
      "id": "all-history",
      "label": "All committed history",
      "predicate": "event_time >= '2026-07-17'",
      "detail": "A broad time predicate retains every manifest and file committed to the selected snapshot.",
      "plans": {
        "before-evolution": {
          "selectedManifestIds": [
            "manifest-day-17",
            "manifest-day-18"
          ],
          "selectedFileIds": [
            "day17-a",
            "day17-b",
            "day18-a",
            "day18-b"
          ],
          "reasoning": [
            "Both daily partition summaries overlap the predicate.",
            "Files committed after snapshot 4401 are invisible because the read is pinned to that snapshot."
          ]
        },
        "after-evolution": {
          "selectedManifestIds": [
            "manifest-day-17",
            "manifest-day-18",
            "manifest-hour-10",
            "manifest-hour-11"
          ],
          "selectedFileIds": [
            "day17-a",
            "day17-b",
            "day18-a",
            "day18-b",
            "hour10-eu",
            "hour10-us",
            "hour11-eu",
            "hour11-us"
          ],
          "reasoning": [
            "The predicate overlaps manifests written with both partition specs.",
            "The snapshot's logical rows are the union of files selected through all four manifests."
          ]
        }
      }
    },
    {
      "id": "one-hour-eu",
      "label": "One hour in Europe",
      "predicate": "event_time >= '2026-07-19 11:00' AND event_time < '2026-07-19 12:00' AND region = 'eu'",
      "detail": "The newer hourly and regional fields make the narrow predicate directly visible to partition pruning.",
      "plans": {
        "before-evolution": {
          "selectedManifestIds": [],
          "selectedFileIds": [],
          "reasoning": [
            "Snapshot 4401 predates every July 19 file in the fixture.",
            "Pinning a snapshot controls visibility before partition pruning begins."
          ]
        },
        "after-evolution": {
          "selectedManifestIds": [
            "manifest-hour-11"
          ],
          "selectedFileIds": [
            "hour11-eu"
          ],
          "reasoning": [
            "The manifest list rejects both daily manifests and the 10:00 manifest by event-time range.",
            "The selected manifest uses spec 1, so its region partition tuple rejects the US file."
          ]
        }
      }
    },
    {
      "id": "eu-history",
      "label": "European history since July 18",
      "predicate": "event_time >= '2026-07-18' AND region = 'eu'",
      "detail": "One logical predicate crosses old daily files and new region-aware files.",
      "plans": {
        "before-evolution": {
          "selectedManifestIds": [
            "manifest-day-18"
          ],
          "selectedFileIds": [
            "day18-a",
            "day18-b"
          ],
          "reasoning": [
            "The day transform rejects the July 17 manifest.",
            "Spec 0 has no region partition field, so this partition-only fixture keeps both July 18 files for row-level filtering."
          ]
        },
        "after-evolution": {
          "selectedManifestIds": [
            "manifest-day-18",
            "manifest-hour-10",
            "manifest-hour-11"
          ],
          "selectedFileIds": [
            "day18-a",
            "day18-b",
            "hour10-eu",
            "hour11-eu"
          ],
          "reasoning": [
            "The reader projects the same source-column predicate through spec 0 and spec 1.",
            "Old daily files remain candidates because they have no region partition value.",
            "New spec-1 files expose region in their partition tuples, so the two US files are pruned."
          ]
        }
      }
    }
  ]
}
