{
  "title": "Trace one read from snapshot to data files",
  "description": "Pin a committed snapshot and choose a source-column predicate. The model shows how partition evolution changes pruning without changing the query.",
  "defaultSnapshotId": "after-evolution",
  "defaultQueryId": "eu-history",
  "partitionSpecs": [
    {
      "id": 0,
      "label": "Spec 0",
      "fields": [
        "day(event_time)"
