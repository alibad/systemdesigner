[
  {
    "id": "code-reconcile-records",
    "kind": "coding",
    "title": "Reconcile versioned records",
    "minutes": 6,
    "lessonPath": "/technology/replication-sharding",
    "concept": "What is record reconciliation?",
    "summary": "Reconciliation combines copies of data using an explicit conflict rule. Versions can identify newer records, but equal versions still need a defined policy.",
    "example": "For the same ID, version 5 replaces version 4. This exercise keeps the local copy when versions are equal.",
    "takeaway": "Track the winning record in a Map, then sort a new array.",
    "instruction": "Merge local and remote arrays of {id, version, value}. Keep the highest version per ID; keep the first encountered record on ties. Process local first. Return records sorted by id. Do not mutate inputs.",
    "hint": "Track the winning record in a Map, then sort a new array.",
    "starterFile": "/api/content/technology/replication-sharding/code/code-reconcile-records.js",
    "functionName": "reconcileRecords",
    "tests": [
      {
        "label": "Newer remote",
        "args": [
          [
            {
              "id": "a",
              "version": 1,
              "value": "old"
            }
          ],
          [
            {
              "id": "a",
              "version": 2,
              "value": "new"
            }
          ]
        ],
        "expected": [
          {
            "id": "a",
            "version": 2,
            "value": "new"
          }
        ]
      },
      {
        "label": "Tie keeps local",
        "args": [
          [
            {
              "id": "a",
              "version": 2,
              "value": "local"
            }
          ],
          [
            {
              "id": "a",
              "version": 2,
              "value": "remote"
            }
          ]
        ],
        "expected": [
          {
            "id": "a",
            "version": 2,
            "value": "local"
          }
        ]
      },
      {
        "label": "Sorted union",
        "args": [
          [
            {
              "id": "z",
              "version": 1,
              "value": 1
            }
          ],
          [
            {
              "id": "a",
              "version": 1,
              "value": 2
            }
          ]
        ],
        "expected": [
          {
            "id": "a",
            "version": 1,
            "value": 2
          },
          {
            "id": "z",
            "version": 1,
            "value": 1
          }
        ]
      },
      {
        "label": "Empty inputs",
        "args": [
          [],
          []
        ],
        "expected": []
      }
    ]
  }
]
