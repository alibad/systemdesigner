{
  "title": "Build a dashboard from a defensible evidence scope",
  "description": "Choose an investigation, time range, and structured filters. The fixed event set makes every count inspectable while showing how Kibana state becomes an Elasticsearch request.",
  "defaults": {
    "queryId": "errors",
    "timeWindowMinutes": 60,
    "environment": "production",
    "service": "all"
  },
  "timeWindows": [
    {
      "minutes": 15,
      "label": "15m"
    },
    {
      "minutes": 60,
      "label": "1h"
    },
    {
      "minutes": 240,
      "label": "4h"
    }
  ],
  "environments": ["all", "production", "staging"],
  "services": ["all", "checkout", "payments", "catalog", "search"],
  "queries": [
    {
      "id": "errors",
      "label": "Find error documents",
      "kql": "log.level: error",
      "description": "Start broad, then use pills and time to isolate the affected slice.",
      "match": {
        "levels": ["error"]
      }
    },
    {
      "id": "slow-checkout",
      "label": "Find slow checkout work",
      "kql": "service.name: checkout AND transaction.duration.us >= 1000000",
      "description": "Test a mapped numeric threshold without pretending KQL computes an aggregate.",
      "match": {
        "service": "checkout",
        "minimumDurationMs": 1000
      }
    },
    {
      "id": "timeouts",
      "label": "Trace timeout failures",
      "kql": "error.type: TimeoutError",
      "description": "Follow one failure class across services and environments.",
      "match": {
        "errorTypes": ["TimeoutError"]
      }
    },
    {
      "id": "server-errors",
      "label": "Inspect HTTP 5xx responses",
      "kql": "http.response.status_code >= 500",
      "description": "Use a range filter against a numeric status field.",
      "match": {
        "minimumStatusCode": 500
      }
    }
  ],
  "events": [
    {
      "id": "evt-01",
      "minutesAgo": 3,
      "service": "checkout",
      "environment": "production",
      "level": "error",
      "durationMs": 1480,
      "statusCode": 504,
      "errorType": "TimeoutError",
      "message": "Inventory reservation exceeded the checkout deadline."
    },
    {
      "id": "evt-02",
      "minutesAgo": 6,
      "service": "payments",
      "environment": "production",
      "level": "error",
      "durationMs": 920,
      "statusCode": 502,
      "errorType": "UpstreamError",
      "message": "Payment provider returned a bad gateway response."
    },
    {
      "id": "evt-03",
      "minutesAgo": 9,
      "service": "catalog",
      "environment": "production",
      "level": "info",
      "durationMs": 180,
      "statusCode": 200,
      "errorType": null,
      "message": "Product detail request completed."
    },
    {
      "id": "evt-04",
      "minutesAgo": 12,
      "service": "checkout",
      "environment": "staging",
      "level": "error",
      "durationMs": 1220,
      "statusCode": 500,
      "errorType": "ValidationError",
      "message": "A staging request omitted the delivery address."
    },
    {
      "id": "evt-05",
      "minutesAgo": 18,
      "service": "search",
      "environment": "production",
      "level": "warn",
      "durationMs": 760,
      "statusCode": 429,
      "errorType": "RateLimitError",
      "message": "Search concurrency crossed the configured request limit."
    },
    {
      "id": "evt-06",
      "minutesAgo": 24,
      "service": "checkout",
      "environment": "production",
      "level": "error",
      "durationMs": 2100,
      "statusCode": 504,
      "errorType": "TimeoutError",
      "message": "Payment authorization did not finish before the deadline."
    },
    {
      "id": "evt-07",
      "minutesAgo": 32,
      "service": "payments",
      "environment": "production",
      "level": "info",
      "durationMs": 260,
      "statusCode": 200,
      "errorType": null,
      "message": "Payment authorization completed."
    },
    {
      "id": "evt-08",
      "minutesAgo": 47,
      "service": "search",
      "environment": "production",
      "level": "error",
      "durationMs": 680,
      "statusCode": 503,
      "errorType": "CircuitOpenError",
      "message": "Search rejected the request while its dependency circuit was open."
    },
    {
      "id": "evt-09",
      "minutesAgo": 63,
      "service": "checkout",
      "environment": "production",
      "level": "error",
      "durationMs": 1110,
      "statusCode": 500,
      "errorType": "DatabaseError",
      "message": "Order persistence failed after the transaction was rolled back."
    },
    {
      "id": "evt-10",
      "minutesAgo": 89,
      "service": "catalog",
      "environment": "staging",
      "level": "error",
      "durationMs": 430,
      "statusCode": 500,
      "errorType": "MappingError",
      "message": "A staging document used an incompatible field type."
    },
    {
      "id": "evt-11",
      "minutesAgo": 118,
      "service": "payments",
      "environment": "production",
      "level": "error",
      "durationMs": 1750,
      "statusCode": 504,
      "errorType": "TimeoutError",
      "message": "Payment status polling reached its request deadline."
    },
    {
      "id": "evt-12",
      "minutesAgo": 146,
      "service": "checkout",
      "environment": "production",
      "level": "info",
      "durationMs": 310,
      "statusCode": 201,
      "errorType": null,
      "message": "Order creation completed."
    },
    {
      "id": "evt-13",
      "minutesAgo": 171,
      "service": "catalog",
      "environment": "production",
      "level": "error",
      "durationMs": 540,
      "statusCode": 503,
      "errorType": "UnavailableError",
      "message": "Catalog replica was unavailable during a read."
    },
    {
      "id": "evt-14",
      "minutesAgo": 205,
      "service": "search",
      "environment": "staging",
      "level": "info",
      "durationMs": 240,
      "statusCode": 200,
      "errorType": null,
      "message": "Staging search request completed."
    }
  ]
}
