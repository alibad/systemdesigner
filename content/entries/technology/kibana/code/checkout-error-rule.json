{
  "consumer": "alerts",
  "name": "Checkout error count",
  "params": {
    "aggType": "count",
    "excludeHitsFromPreviousRun": true,
    "groupBy": "all",
    "searchConfiguration": {
      "index": "DATA_VIEW_SAVED_OBJECT_ID",
      "query": {
        "language": "kuery",
        "query": "service.name: checkout AND log.level: error"
      }
    },
    "searchType": "searchSource",
    "size": 100,
    "threshold": [5],
    "thresholdComparator": ">=",
    "timeWindowSize": 5,
    "timeWindowUnit": "m"
  },
  "rule_type_id": ".es-query",
  "schedule": {
    "interval": "1m"
  },
  "actions": []
}
