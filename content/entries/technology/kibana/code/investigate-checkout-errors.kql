# KQL filters documents. The dashboard time picker is a separate global filter.
service.name: checkout AND log.level: error

# Numeric range against a mapped duration field.
service.name: checkout AND transaction.duration.us >= 1000000

# Exact keyword values can isolate one production failure mode.
environment: production AND error.type: TimeoutError

# KQL does not aggregate, transform, or sort these results.
http.response.status_code >= 500 AND NOT host.name: canary-*
