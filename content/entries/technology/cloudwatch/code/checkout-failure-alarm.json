{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Alarm on a sparse checkout failure metric.",
  "Parameters": {
    "AlarmTopicArn": {
      "Type": "String",
      "Description": "ARN of the reviewed SNS topic for alarm state changes"
    }
  },
  "Resources": {
    "CheckoutFailureAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-checkout-failures"
        },
        "AlarmDescription": "Two failure periods within five minutes require investigation.",
        "Namespace": "Example/Checkout",
        "MetricName": "Failures",
        "Dimensions": [
          {
            "Name": "Service",
            "Value": "checkout"
          },
          {
            "Name": "Environment",
            "Value": "production"
          }
        ],
        "Statistic": "Sum",
        "Period": 60,
        "EvaluationPeriods": 5,
        "DatapointsToAlarm": 2,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "AlarmTopicArn"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlarmTopicArn"
          }
        ]
      }
    }
  }
}
