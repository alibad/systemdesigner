<broker xmlns="http://activemq.apache.org/schema/core"
        brokerName="orders-broker"
        persistent="true"
        useJmx="true">
  <destinationPolicy>
    <policyMap>
      <policyEntries>
        <policyEntry queue=">"
                     producerFlowControl="true"
                     memoryLimit="256mb">
          <deadLetterStrategy>
            <individualDeadLetterStrategy queuePrefix="DLQ."/>
          </deadLetterStrategy>
        </policyEntry>
      </policyEntries>
    </policyMap>
  </destinationPolicy>

  <persistenceAdapter>
    <kahaDB directory="${activemq.data}/kahadb"/>
  </persistenceAdapter>

  <systemUsage>
    <systemUsage>
      <memoryUsage>
        <memoryUsage limit="1 gb"/>
      </memoryUsage>
      <storeUsage>
        <storeUsage limit="100 gb"/>
      </storeUsage>
      <tempUsage>
        <tempUsage limit="20 gb"/>
      </tempUsage>
    </systemUsage>
  </systemUsage>

  <transportConnectors>
    <transportConnector name="openwire" uri="tcp://127.0.0.1:61616"/>
  </transportConnectors>
</broker>
