[
  {
    "id": "code-unique-ids",
    "kind": "coding",
    "title": "Remove duplicate IDs",
    "minutes": 6,
    "lessonPath": "/fundamentals/data-modeling",
    "concept": "What is deduplication?",
    "summary": "Deduplication keeps one copy of each identity when the same item appears multiple times. Identity, rather than arrival count, determines whether work is new.",
    "example": "[\"a\", \"b\", \"a\"] becomes [\"a\", \"b\"].",
    "takeaway": "A Set remembers whether a value has appeared.",
    "instruction": "Return unique string IDs in first-seen order. Do not change the input array.",
    "hint": "A Set remembers whether a value has appeared.",
    "starterFile": "/api/content/fundamentals/data-modeling/code/code-unique-ids.js",
    "functionName": "uniqueIds",
    "tests": [
      {
        "label": "Repeated IDs",
        "args": [
          [
            "a",
            "b",
            "a",
            "c",
            "b"
          ]
        ],
        "expected": [
          "a",
          "b",
          "c"
        ]
      },
      {
        "label": "Empty input",
        "args": [
          []
        ],
        "expected": []
      },
      {
        "label": "Case matters",
        "args": [
          [
            "A",
            "a",
            "A"
          ]
        ],
        "expected": [
          "A",
          "a"
        ]
      },
      {
        "label": "Empty ID is a value",
        "args": [
          [
            "",
            "x",
            ""
          ]
        ],
        "expected": [
          "",
          "x"
        ]
      }
    ]
  },
  {
    "id": "code-count-events",
    "kind": "coding",
    "title": "Count event types",
    "minutes": 6,
    "lessonPath": "/fundamentals/data-modeling",
    "concept": "What is a frequency table?",
    "summary": "A frequency table maps each distinct value to the number of times it occurs. It is useful for counting requests, errors, or event categories.",
    "example": "[\"read\", \"write\", \"read\"] gives read: 2 and write: 1.",
    "takeaway": "Use a Map while counting, then convert it to an object.",
    "instruction": "Return an object mapping each string event type to its count. Treat every string as a valid key, including reserved object names.",
    "hint": "Use a Map while counting, then convert it to an object.",
    "starterFile": "/api/content/fundamentals/data-modeling/code/code-count-events.js",
    "functionName": "countEvents",
    "tests": [
      {
        "label": "Count repeated types",
        "args": [
          [
            "read",
            "write",
            "read"
          ]
        ],
        "expected": {
          "read": 2,
          "write": 1
        }
      },
      {
        "label": "Empty input",
        "args": [
          []
        ],
        "expected": {}
      },
      {
        "label": "Object-like keys",
        "args": [
          [
            "__proto__",
            "constructor",
            "__proto__"
          ]
        ],
        "expected": {
          "__proto__": 2,
          "constructor": 1
        }
      },
      {
        "label": "Single type",
        "args": [
          [
            "error"
          ]
        ],
        "expected": {
          "error": 1
        }
      }
    ]
  },
  {
