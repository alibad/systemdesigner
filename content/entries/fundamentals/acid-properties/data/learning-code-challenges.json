[
  {
    "id": "code-idempotency",
    "kind": "coding",
    "title": "Recognize a retried operation",
    "minutes": 6,
    "lessonPath": "/fundamentals/acid-properties",
    "concept": "What is idempotency?",
    "summary": "An idempotent operation has the same effect when repeated. An idempotency key identifies retries of one logical request so the stored result can be reused.",
    "example": "A payment retry with an existing key should return the saved result without charging again.",
    "takeaway": "Existence matters even when the stored result is null or false.",
    "instruction": "If records has its own key, return {execute: false, result: records[key]}. Otherwise return {execute: true, result: null}. Do not modify records.",
    "hint": "Existence matters even when the stored result is null or false.",
    "starterFile": "/api/content/fundamentals/acid-properties/code/code-idempotency.js",
    "functionName": "checkIdempotency",
    "tests": [
      {
        "label": "Saved result",
        "args": [
          {
            "k": {
              "paid": true
            }
          },
          "k"
        ],
        "expected": {
          "execute": false,
          "result": {
            "paid": true
          }
        }
      },
      {
        "label": "New operation",
        "args": [
          {},
          "new"
        ],
        "expected": {
          "execute": true,
          "result": null
        }
      },
      {
        "label": "Null result",
        "args": [
          {
            "k": null
          },
          "k"
        ],
        "expected": {
          "execute": false,
          "result": null
        }
      },
      {
        "label": "Inherited name",
        "args": [
          {},
          "constructor"
        ],
        "expected": {
          "execute": true,
          "result": null
        }
      }
    ]
  },
  {
    "id": "code-version-write",
    "kind": "coding",
    "title": "Reject a stale write",
    "minutes": 6,
    "lessonPath": "/fundamentals/acid-properties",
    "concept": "What is optimistic concurrency?",
    "summary": "Optimistic concurrency checks that a record has not changed since it was read. A version mismatch rejects a stale update instead of silently replacing newer work.",
    "example": "A client expecting version 3 cannot update a record that has already reached version 4.",
    "takeaway": "Compare the version before constructing the updated record.",
    "instruction": "Given {version, value}, expectedVersion, and a new value, return {updated, record}. Increment version on a match. Otherwise return the unchanged record. Do not mutate input.",
    "hint": "Compare the version before constructing the updated record.",
    "starterFile": "/api/content/fundamentals/acid-properties/code/code-version-write.js",
    "functionName": "writeVersion",
    "tests": [
      {
        "label": "Matching version",
        "args": [
          {
            "version": 3,
            "value": "old"
          },
          3,
          "new"
        ],
        "expected": {
          "updated": true,
          "record": {
            "version": 4,
            "value": "new"
          }
        }
      },
      {
        "label": "Stale client",
        "args": [
          {
            "version": 4,
            "value": "latest"
          },
          3,
          "stale"
        ],
        "expected": {
          "updated": false,
          "record": {
            "version": 4,
            "value": "latest"
          }
        }
      },
      {
        "label": "First version",
        "args": [
          {
            "version": 0,
            "value": null
          },
          0,
          0
        ],
        "expected": {
          "updated": true,
          "record": {
            "version": 1,
            "value": 0
          }
        }
      },
      {
        "label": "Future expectation",
        "args": [
          {
            "version": 2,
            "value": 1
          },
          5,
          2
        ],
        "expected": {
          "updated": false,
          "record": {
            "version": 2,
            "value": 1
          }
        }
      }
    ]
  }
]
