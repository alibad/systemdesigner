[
  {
    "id": "code-link-service",
    "kind": "coding",
    "title": "Build a tiny link service",
    "minutes": 12,
    "lessonPath": "/fundamentals/url-shortener-read-path",
    "concept": "What is a request handler?",
    "summary": "A request handler turns an incoming action into a response. In this model, GET reads a saved destination and PUT changes it. A cache speeds up repeated reads, while the records object is the source of truth.",
    "example": "GET go \u2192 /old. PUT go /new \u2192 saved. GET go must now return /new, even if /old was cached.",
    "takeaway": "A fast read path is useful only when updates preserve correctness. Keep the source of truth and invalidate stale copies.",
    "instruction": "Process requests in order. GET: check the cache first; on a miss count one database read, return {status:302, location:value} for a stored key and cache it, or {status:404} without caching a miss. PUT: store value, invalidate that key in the cache, and return {status:204}. Other methods return {status:405} without reading or changing records. Start with an empty cache. Return {records, responses, databaseReads}. Keys and values are strings, including keys that match JavaScript object names. This is an in-memory simulation, not a network server. Preserve both inputs.",
    "hint": "Try new Map(Object.entries(initial)) for records and a separate Map for the cache. A Map stores keys without inherited object properties. Use has/get/set/delete inside a for...of loop; return Object.fromEntries(records). Count only GET cache misses.",
    "starterFile": "/api/content/fundamentals/url-shortener-read-path/code/code-link-service.js",
    "functionName": "handleRequests",
    "tests": [
      {
        "label": "Empty request log",
        "args": [
          {},
          []
        ],
        "expected": {
          "records": {},
          "responses": [],
          "databaseReads": 0
        }
      },
      {
        "label": "First read fills cache; second read is a cache hit",
        "args": [
          {
            "go": "/welcome"
          },
          [
            {
              "method": "GET",
              "key": "go"
            },
            {
              "method": "GET",
              "key": "go"
            }
          ]
        ],
        "expected": {
          "records": {
            "go": "/welcome"
          },
          "responses": [
            {
              "status": 302,
              "location": "/welcome"
            },
            {
              "status": 302,
              "location": "/welcome"
            }
          ],
          "databaseReads": 1
        }
      },
      {
        "label": "Missing keys return 404 and are not cached",
        "args": [
          {},
          [
            {
              "method": "GET",
              "key": "missing"
            },
            {
              "method": "GET",
              "key": "missing"
            }
          ]
        ],
        "expected": {
          "records": {},
          "responses": [
            {
              "status": 404
            },
            {
              "status": 404
            }
          ],
          "databaseReads": 2
        }
      },
      {
        "label": "Write, read, update, then read the fresh destination",
        "args": [
          {},
          [
            {
              "method": "PUT",
              "key": "go",
              "value": "/old"
            },
            {
              "method": "GET",
              "key": "go"
            },
            {
              "method": "PUT",
              "key": "go",
              "value": "/new"
            },
            {
              "method": "GET",
              "key": "go"
            }
          ]
        ],
        "expected": {
          "records": {
            "go": "/new"
          },
          "responses": [
            {
              "status": 204
            },
            {
              "status": 302,
              "location": "/old"
            },
            {
              "status": 204
            },
            {
              "status": 302,
              "location": "/new"
            }
          ],
          "databaseReads": 2
        }
      },
      {
        "label": "An update invalidates only its own key",
        "args": [
          {
            "a": "/one",
            "b": "/two"
          },
          [
            {
              "method": "GET",
              "key": "a"
            },
            {
              "method": "GET",
              "key": "b"
            },
            {
              "method": "PUT",
              "key": "a",
              "value": "/three"
            },
            {
              "method": "GET",
              "key": "b"
            },
            {
              "method": "GET",
              "key": "a"
            }
          ]
        ],
        "expected": {
          "records": {
            "a": "/three",
            "b": "/two"
          },
          "responses": [
            {
              "status": 302,
              "location": "/one"
            },
            {
              "status": 302,
              "location": "/two"
            },
            {
              "status": 204
            },
            {
              "status": 302,
              "location": "/two"
            },
            {
              "status": 302,
              "location": "/three"
            }
          ],
          "databaseReads": 3
        }
      },
      {
        "label": "Unsupported methods do not read or change records",
        "args": [
          {
            "go": "/welcome"
          },
          [
            {
              "method": "DELETE",
              "key": "go"
            },
            {
              "method": "GET",
              "key": "go"
            }
          ]
        ],
        "expected": {
          "records": {
            "go": "/welcome"
          },
          "responses": [
            {
              "status": 405
            },
            {
              "status": 302,
              "location": "/welcome"
            }
          ],
          "databaseReads": 1
        }
      },
      {
        "label": "Inherited object names are not stored links",
        "args": [
          {},
          [
            {
              "method": "GET",
              "key": "toString"
            }
          ]
        ],
        "expected": {
          "records": {},
          "responses": [
            {
              "status": 404
            }
          ],
          "databaseReads": 1
        }
      },
      {
        "label": "Object-name keys and empty destinations remain valid data",
        "args": [
          {},
          [
            {
              "method": "PUT",
              "key": "__proto__",
              "value": ""
            },
            {
              "method": "GET",
              "key": "__proto__"
            },
            {
              "method": "GET",
              "key": "__proto__"
            }
          ]
        ],
        "expected": {
          "records": {
            "__proto__": ""
          },
          "responses": [
            {
              "status": 204
            },
            {
              "status": 302,
              "location": ""
            },
            {
              "status": 302,
              "location": ""
            }
          ],
          "databaseReads": 1
        }
      }
    ]
  }
]
