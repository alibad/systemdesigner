{
  "replicaCount": 5,
  "defaults": {
    "readQuorum": 3,
    "writeQuorum": 3,
    "failedReplicas": 0
  },
  "bounds": {
    "readQuorum": { "min": 1, "max": 5, "step": 1 },
    "writeQuorum": { "min": 1, "max": 5, "step": 1 },
    "failedReplicas": { "min": 0, "max": 4, "step": 1 }
  },
  "coordinationOverheadMs": {
    "read": 3,
    "write": 7
  },
  "replicas": [
    { "id": "replica-a", "label": "Zone A", "latencyMs": 7 },
    { "id": "replica-b", "label": "Zone B", "latencyMs": 11 },
    { "id": "replica-c", "label": "Zone C", "latencyMs": 16 },
    { "id": "replica-d", "label": "Region D", "latencyMs": 42 },
    { "id": "replica-e", "label": "Region E", "latencyMs": 68 }
  ],
  "failureScenarios": [
    { "failedCount": 0, "failedReplicaIds": [], "detail": "All five replicas can acknowledge operations." },
    { "failedCount": 1, "failedReplicaIds": ["replica-b"], "detail": "Zone B is unreachable; four replicas remain." },
    { "failedCount": 2, "failedReplicaIds": ["replica-b", "replica-d"], "detail": "One local zone and one remote region are unreachable." },
    { "failedCount": 3, "failedReplicaIds": ["replica-b", "replica-c", "replica-d"], "detail": "Only two replicas remain; majority operations cannot complete." },
    { "failedCount": 4, "failedReplicaIds": ["replica-b", "replica-c", "replica-d", "replica-e"], "detail": "A single replica survives without peers to establish a majority." }
  ]
}
