### Read a stable page of orders
GET /v1/orders?status=open&limit=25&cursor=eyJjcmVhdGVkX2F0IjoiMjAyNi0wNy0xOFQxMDowMDowMFoiLCJvcmRlcl9pZCI6Im9yZF83MSJ9
Authorization: Bearer <access-token>

HTTP/1.1 200 OK
Content-Type: application/json

{
  "data": [{ "id": "ord_71", "status": "open" }],
  "meta": { "limit": 25, "next_cursor": "eyJjcmVhdGVkX2F0IjoiMjAyNi0wNy0xOFQwOTo1ODowMFoiLCJvcmRlcl9pZCI6Im9yZF83MCJ9" },
  "error": null
}

### Create once, even when the network response is lost
POST /v1/orders
Authorization: Bearer <access-token>
Idempotency-Key: 82e7a9fb-3b13-4b8f-8436-5e3f4f6db779
Content-Type: application/json

{ "customer_id": "cus_42", "items": [{ "sku": "sku_7", "quantity": 1 }] }

HTTP/1.1 201 Created
Location: /v1/orders/ord_72
Content-Type: application/json

{ "data": { "id": "ord_72", "status": "pending" }, "meta": {}, "error": null }

### Record a cancellation; do not erase the order
POST /v1/orders/ord_72/cancellations
Authorization: Bearer <access-token>
Content-Type: application/json

{ "reason": "customer_changed_mind" }
