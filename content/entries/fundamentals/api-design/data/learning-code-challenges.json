[
  {
    "id": "code-validate-limit",
    "kind": "coding",
    "title": "Validate a request limit",
    "minutes": 6,
    "lessonPath": "/fundamentals/api-design",
    "concept": "What is input validation?",
    "summary": "Input validation checks whether a request value has the shape and range an API accepts. It stops ambiguous or invalid inputs before they reach the main operation.",
    "example": "A limit of 25 is accepted; 0, \"25\", and 2.5 are rejected.",
    "takeaway": "Use Number.isInteger, then check both bounds.",
    "instruction": "Return the numeric limit only if it is an integer between 1 and 100 inclusive. Return null otherwise. Do not coerce strings.",
    "hint": "Use Number.isInteger, then check both bounds.",
    "starterFile": "/api/content/fundamentals/api-design/code/code-validate-limit.js",
    "functionName": "validateLimit",
    "tests": [
      {
        "label": "Valid limit",
        "args": [
          25
        ],
        "expected": 25
      },
      {
        "label": "Lower bound",
        "args": [
          1
        ],
        "expected": 1
      },
      {
        "label": "Too large",
        "args": [
          101
        ],
        "expected": null
      },
      {
        "label": "Do not coerce",
        "args": [
          "25"
        ],
        "expected": null
      },
      {
        "label": "Reject fractions",
        "args": [
          2.5
        ],
        "expected": null
      },
      {
        "label": "Reject zero",
        "args": [
          0
        ],
        "expected": null
      }
    ]
  },
  {
    "id": "code-normalize-event",
    "kind": "coding",
    "title": "Normalize an incoming event",
    "minutes": 6,
    "lessonPath": "/fundamentals/api-design",
    "concept": "What is normalization?",
    "summary": "Normalization converts accepted input into one predictable representation. Validation must still reject values that cannot be interpreted safely.",
    "example": "{id: \"  a1 \", type: \" CREATED \"} becomes {id: \"a1\", type: \"created\"}.",
    "takeaway": "Check types before calling string methods. Keep identifiers case-sensitive.",
    "instruction": "Return only {id, type}, trimming both string fields and lowercasing type. Return null for non-object input, missing/non-string fields, or fields that become empty.",
    "hint": "Check types before calling string methods. Keep identifiers case-sensitive.",
    "starterFile": "/api/content/fundamentals/api-design/code/code-normalize-event.js",
    "functionName": "normalizeEvent",
    "tests": [
      {
        "label": "Trim and normalize",
        "args": [
          {
            "id": "  A1 ",
            "type": " CREATED ",
            "extra": 1
          }
        ],
        "expected": {
          "id": "A1",
          "type": "created"
        }
      },
      {
        "label": "Missing type",
        "args": [
          {
            "id": "x"
          }
        ],
        "expected": null
      },
      {
        "label": "Null input",
        "args": [
          null
        ],
        "expected": null
      },
      {
        "label": "Empty identifier",
        "args": [
          {
            "id": "  ",
            "type": "x"
          }
        ],
        "expected": null
      },
      {
        "label": "Numeric type",
        "args": [
          {
            "id": "x",
            "type": 4
          }
        ],
        "expected": null
      }
    ]
  },
  {
    "id": "code-page-results",
    "kind": "coding",
    "title": "Return a bounded page",
    "minutes": 6,
    "lessonPath": "/fundamentals/api-design",
    "concept": "What is pagination?",
    "summary": "Pagination splits a result set into bounded responses. A predictable offset and limit keep one request from returning an unbounded amount of data.",
    "example": "An offset of 2 and limit of 2 returns the third and fourth items.",
    "takeaway": "Validate the bounds before using slice.",
    "instruction": "Return items.slice(offset, offset + limit) for nonnegative integer offset and positive integer limit. Return [] for invalid bounds. Do not mutate items.",
    "hint": "Validate the bounds before using slice.",
    "starterFile": "/api/content/fundamentals/api-design/code/code-page-results.js",
    "functionName": "pageResults",
    "tests": [
      {
        "label": "Middle page",
        "args": [
          [
            1,
            2,
            3,
            4,
            5
          ],
          2,
          2
        ],
        "expected": [
          3,
          4
        ]
      },
      {
        "label": "Past the end",
        "args": [
          [
            1,
            2
          ],
          5,
          2
        ],
        "expected": []
      },
      {
        "label": "Negative offset",
        "args": [
          [
            1,
            2
          ],
          -1,
