[
  {
    "id": "code-apply-events",
    "kind": "coding",
    "title": "Apply events exactly once locally",
    "minutes": 6,
    "lessonPath": "/fundamentals/event-driven-architecture",
    "concept": "What is an event projection?",
    "summary": "A projection derives current state from a sequence of events. Remembering applied event IDs prevents a retry from affecting the projection twice within this state store.",
    "example": "Starting at 10, event a(+3), a(+3), b(-2) produces 11 when a is counted once.",
    "takeaway": "Initialize a Set from seen and add each new ID before applying its delta.",
    "instruction": "Given {total, seen}, apply events [{id, delta}] once per unseen ID. Return a new {total, seen}, preserving first-seen order. Inputs contain numeric deltas and string IDs. This is local deduplication, not a distributed exactly-once guarantee.",
    "hint": "Initialize a Set from seen and add each new ID before applying its delta.",
    "starterFile": "/api/content/fundamentals/event-driven-architecture/code/code-apply-events.js",
    "functionName": "applyEvents",
    "tests": [
      {
        "label": "Retry in one batch",
        "args": [
          {
            "total": 10,
            "seen": []
          },
          [
            {
              "id": "a",
              "delta": 3
            },
            {
              "id": "a",
              "delta": 3
            },
            {
              "id": "b",
              "delta": -2
            }
          ]
        ],
        "expected": {
          "total": 11,
          "seen": [
            "a",
            "b"
          ]
        }
      },
      {
        "label": "Previously applied",
        "args": [
          {
            "total": 4,
            "seen": [
              "a"
            ]
          },
          [
            {
              "id": "a",
              "delta": 9
            }
          ]
        ],
        "expected": {
          "total": 4,
          "seen": [
            "a"
          ]
        }
      },
      {
        "label": "Empty batch",
        "args": [
          {
            "total": 0,
            "seen": []
          },
          []
        ],
        "expected": {
          "total": 0,
          "seen": []
        }
      },
      {
        "label": "Zero delta",
        "args": [
          {
            "total": 2,
            "seen": []
          },
          [
            {
              "id": "z",
              "delta": 0
            }
          ]
        ],
        "expected": {
          "total": 2,
          "seen": [
            "z"
          ]
        }
      }
    ]
  }
]
