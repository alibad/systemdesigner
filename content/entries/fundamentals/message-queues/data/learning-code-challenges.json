  {
    "id": "code-dead-letter",
    "kind": "coding",
    "title": "Separate retries from dead letters",
    "minutes": 6,
    "lessonPath": "/fundamentals/message-queues",
    "concept": "What is a dead-letter queue?",
    "summary": "A dead-letter queue holds work that cannot be processed after its retry budget. It preserves failed jobs for inspection instead of retrying forever or silently discarding them.",
    "example": "With a maximum of 3 attempts, a job at attempt 2 can retry; a job at attempt 3 is dead-lettered.",
    "takeaway": "Make the retry-budget boundary explicit.",
    "instruction": "Partition failed jobs [{id, attempts}] into {retry, deadLetter} ID arrays. attempts counts attempts already made. Jobs with attempts >= maxAttempts go to deadLetter. Preserve input order.",
    "hint": "Make the retry-budget boundary explicit.",
    "starterFile": "/api/content/fundamentals/message-queues/code/code-dead-letter.js",
    "functionName": "partitionFailures",
    "tests": [
      {
        "label": "Retry boundary",
        "args": [
          [
            {
              "id": "a",
              "attempts": 2
            },
            {
              "id": "b",
              "attempts": 3
            }
          ],
          3
        ],
        "expected": {
          "retry": [
            "a"
          ],
          "deadLetter": [
            "b"
          ]
        }
      },
      {
        "label": "Over budget",
        "args": [
          [
            {
              "id": "a",
              "attempts": 5
            }
          ],
          3
        ],
        "expected": {
          "retry": [],
          "deadLetter": [
            "a"
          ]
        }
      },
      {
        "label": "Empty input",
        "args": [
          [],
          3
        ],
        "expected": {
          "retry": [],
          "deadLetter": []
        }
      },
      {
        "label": "Multiple retries",
        "args": [
          [
            {
              "id": "a",
              "attempts": 0
            },
            {
              "id": "b",
              "attempts": 1
            }
          ],
          3
        ],
        "expected": {
          "retry": [
            "a",
            "b"
          ],
          "deadLetter": []
        }
      }
    ]
  },
  {
    "id": "code-worker-plan",
    "kind": "coding",
    "title": "Build a bounded worker plan",
    "minutes": 6,
    "lessonPath": "/fundamentals/message-queues",
    "concept": "What is a worker scheduling plan?",
    "summary": "A worker plan decides which queued jobs may execute now, which must wait, and which have exhausted their retry budget. Capacity and retry limits apply before work starts.",
    "example": "A due job with retries left may run; a future job waits; a job at its retry limit goes to dead letters.",
    "takeaway": "Separate exhausted jobs, select eligible work with a stable sort, then classify the remaining IDs.",
    "instruction": "Given jobs [{id, readyAt, attempts}], now, nonnegative integer capacity, and positive maxAttempts, return {run, waiting, deadLetter} IDs. Classify exhausted jobs first. Select due jobs by readyAt then id, up to capacity. Preserve original order in waiting and deadLetter. Do not mutate input.",
    "hint": "Separate exhausted jobs, select eligible work with a stable sort, then classify the remaining IDs.",
