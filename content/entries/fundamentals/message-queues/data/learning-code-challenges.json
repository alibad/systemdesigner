[
  {
    "id": "code-batch-dedup",
    "kind": "coding",
    "title": "Build a deduplicating batcher",
    "minutes": 6,
    "lessonPath": "/fundamentals/message-queues",
    "concept": "What is a batch?",
    "summary": "A batch groups several items into one unit of work. Deduplicating before batching avoids performing the same logical job twice in one submission.",
    "example": "IDs [a, b, a, c] with a batch size of 2 become [[a, b], [c]].",
    "takeaway": "Deduplicate first, then take slices without changing the input.",
    "instruction": "Return batches of unique string IDs, preserving first-seen order. Each batch has at most size items. Return [] if size is not a positive integer.",
    "hint": "Deduplicate first, then take slices without changing the input.",
    "starterFile": "/api/content/fundamentals/message-queues/code/code-batch-dedup.js",
    "functionName": "batchUnique",
    "tests": [
      {
        "label": "Deduplicate and split",
        "args": [
          [
            "a",
            "b",
            "a",
            "c"
          ],
          2
        ],
        "expected": [
          [
            "a",
            "b"
          ],
          [
            "c"
          ]
        ]
      },
      {
        "label": "Empty input",
        "args": [
          [],
          3
        ],
        "expected": []
      },
      {
        "label": "Invalid size",
        "args": [
          [
            "a"
          ],
          0
        ],
        "expected": []
      },
      {
        "label": "Fractional size",
        "args": [
          [
            "a"
          ],
          1.5
        ],
        "expected": []
      },
      {
        "label": "Large batch",
        "args": [
          [
            "x",
            "y"
          ],
          9
        ],
        "expected": [
          [
            "x",
            "y"
          ]
        ]
      }
    ]
  },
  {
    "id": "code-backoff",
    "kind": "coding",
    "title": "Calculate bounded retry delays",
    "minutes": 6,
    "lessonPath": "/fundamentals/message-queues",
    "concept": "What is exponential backoff?",
    "summary": "Exponential backoff increases the wait between failed attempts. A cap prevents the delay from growing without bound. Production systems often add jitter so clients do not retry together.",
    "example": "With a 100 ms base, attempts 0, 1, and 2 wait 100, 200, and 400 ms.",
    "takeaway": "The first retry uses attempt 0, so its delay equals the base.",
    "instruction": "Return min(capMs, baseMs * 2 ** attempt) for a nonnegative integer attempt and positive numeric base/cap. Jitter is deliberately excluded from this deterministic exercise.",
    "hint": "The first retry uses attempt 0, so its delay equals the base.",
    "starterFile": "/api/content/fundamentals/message-queues/code/code-backoff.js",
    "functionName": "retryDelay",
    "tests": [
      {
        "label": "First retry",
        "args": [
          0,
          100,
          1000
        ],
        "expected": 100
      },
      {
        "label": "Exponential growth",
        "args": [
          3,
          100,
          1000
        ],
        "expected": 800
      },
      {
        "label": "Cap long retries",
        "args": [
          8,
          100,
          1000
        ],
        "expected": 1000
      },
      {
        "label": "Cap below base",
        "args": [
          0,
          1000,
          100
        ],
        "expected": 100
      }
    ]
  },
  {
    "id": "code-ready-jobs",
