    "title": "Schedule only ready jobs",
    "minutes": 6,
    "lessonPath": "/fundamentals/message-queues",
    "concept": "What is delayed work?",
    "summary": "A delayed job has an earliest execution time. A scheduler should run only due work, using a deterministic order when multiple jobs become ready together.",
    "example": "At now=50, jobs scheduled at 40 and 50 are ready; a job scheduled at 51 must wait.",
    "takeaway": "Filter before sorting, then take a bounded slice.",
    "instruction": "Return up to limit ready job IDs, sorted by readyAt and then id. Include readyAt === now. limit is a nonnegative integer. Do not change jobs.",
    "hint": "Filter before sorting, then take a bounded slice.",
    "starterFile": "/api/content/fundamentals/message-queues/code/code-ready-jobs.js",
    "functionName": "readyJobs",
    "tests": [
